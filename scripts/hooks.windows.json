{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}\\..\\bin\\squadrn.exe", "args": ["hook", "guard-git"], "timeout": 5, "onFailure": "block" }]
      }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}\\..\\bin\\squadrn.exe", "args": ["hook", "notify", "Needs input"], "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}\\..\\bin\\squadrn.exe", "args": ["hook", "notify", "Done"], "async": true }] }
    ],
    "StopFailure": [
      { "matcher": "rate_limit", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}\\..\\bin\\squadrn.exe", "args": ["hook", "limit"], "async": true }] }
    ]
  }
}
