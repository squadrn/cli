#!/bin/sh
# Plugin hook entrypoint: hands off to `squadrn hook`. The binary is found at its fixed install
# path first, so it works whatever command name the user chose. Fails closed: when squadrn is
# missing, git pushes are denied and other git commands are asked about, rather than run unguarded.
for c in "${XDG_DATA_HOME:-$HOME/.local/share}/squadrn/bin/squadrn" "$(command -v squadrn 2>/dev/null)"; do
  if [ -n "$c" ] && [ -x "$c" ]; then exec "$c" hook "$@"; fi
done
if [ "$1" != guard-git ]; then
  cat >/dev/null
  exit 0
fi
# --no-ask: the agent CLI cannot ask (Codex and Gemini let the call through), so asking becomes
# denying. A denial is exit 2 with the reason on stderr, which blocks the call in Claude Code, Codex
# and Gemini CLI alike (Gemini ignores Claude Code's JSON reply).
noask=
for a in "$@"; do
  [ "$a" = --no-ask ] && noask=1
done
decide() {
  if [ -n "$noask" ] && [ "$1" = ask ]; then set -- deny "$2"; fi
  reason="squadrn guard: squadrn is not installed, so $2. Install squadrn or remove the squadrn plugin."
  if [ "$1" = deny ]; then
    printf '%s\n' "$reason" >&2
    exit 2
  fi
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"}}\n' "$1" "$reason"
}
# Lower-cased, with quotes and backslashes removed, so pu''sh and P\USH still match.
input=$(tr '[:upper:]' '[:lower:]' | tr -d "\"'\\\\")
case "$input" in
  *push*) decide deny "git push is blocked" ;;
  *git*) decide ask "git commands cannot be checked" ;;
esac
exit 0
