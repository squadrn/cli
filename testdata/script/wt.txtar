[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
mkdir home/.claude-personal repo/sub

# wt runs claude --worktree from the repo root, whatever subdirectory it is called from.
cd repo/sub
exec squadrn wt feat-a
stdout '^cfg=<unset> args=--worktree feat-a$'
grep 'pwd=.*/repo args=--worktree feat-a' ../../home/calls.log
exec squadrn personal wt feat-b
stdout '^cfg=.*/home/.claude-personal args=--worktree feat-b$'
exec squadrn wt feat-c -a claude/personal
stdout '^cfg=.*/home/.claude-personal args=--worktree feat-c$'

# The session is recorded for gc and wt rm: in the repo root while the worktree does not exist
# yet (git never sees the registry), and in the account dir.
exec sh -c 'cat ../.squadrn-inuse/*.json'
stdout '"worktree":"feat-c"'
stdout '"account":"claude/personal"'
exec sh -c 'cat ../../home/.claude-personal/.squadrn-inuse/*.json'
stdout '"account":"claude/personal"'
grep '^\.squadrn-inuse/$' ../.git/info/exclude
exec git -C .. status --porcelain
! stdout .

exitcode 2 squadrn wt Bad_Name
exitcode 2 squadrn wt
exitcode 1 squadrn wt feat-d -a ghost

# wt ls shows an agent started in a terminal (outside a grid) as running, in --json too.
exec git -C .. worktree add -q -b worktree-feat-h .claude/worktrees/feat-h
env FAKE_HOLD=22222222-2222-4222-8222-222222222222
exec squadrn personal wt feat-h &
waitfor $WORK/home/held.txt '^[0-9]+$'
env FAKE_HOLD=
exec squadrn wt ls
stdout '^feat-h +worktree-feat-h +clean +claude/personal$'
exec squadrn wt ls --json
stdout '"running_as": "claude/personal"'
kill -INT
wait
exec squadrn wt ls --json
stdout '"running_as": ""'
cd $WORK
exitcode 1 squadrn wt feat-a
-- home/.claude-personal/.squadrn-account --
