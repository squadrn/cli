[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Hook usage names the installed binary the hooks run through.
exec squadrn hook --help
stdout '^usage: squadrn hook guard-git \| '
stdout '^internal: the squadrn plugin \(squadrn-hook\) and git hooks run this through the installed binary$'
exitcode 2 squadrn hook bogus

# Repositories: one on a feature branch, one with its own protected list.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_NOSYSTEM=1
exec git init -q -b feat-x feat
exec git init -q -b feat-x prod
exec git -C prod config squadrn.protectedBranches production
mkdir home/.config/squadrn

# Allowed commands produce no output and exit 0.
stdin allow.json
exec squadrn hook guard-git
! stdout .

# Denials follow Claude Code's PreToolUse protocol.
stdin force.json
exec squadrn hook guard-git
stdout '"hookEventName":"PreToolUse"'
stdout '"permissionDecision":"deny"'
stdout '"permissionDecisionReason":"squadrn guard: force push is not allowed \(-f\)"'

# Denials and asks are logged with credentials masked.
stdin token.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'
exists home/.local/state/squadrn/guard.log
grep 'deny\tpre-tool\tfeat\tdirect push to protected branch "main"' home/.local/state/squadrn/guard.log
grep 'https://\*\*\*@github.com' home/.local/state/squadrn/guard.log
! grep 's3cr3t' home/.local/state/squadrn/guard.log

# Runtime-only targets ask instead of guessing.
stdin dynamic.json
exec squadrn hook guard-git
stdout '"permissionDecision":"ask"'

# A repo's own list only adds to the user's: main stays protected, production is too.
stdin prod-main.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'
stdin prod-disable.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'
stdin prod-production.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'

# The config file changes the default list for every repo.
stdin feat-staging.json
exec squadrn hook guard-git
! stdout .
cp staging.toml home/.config/squadrn/config.toml
stdin feat-staging.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'

# The PowerShell tool (Windows) goes through the PowerShell analyser; unknown tools ask.
stdin ps-force.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'
stdin ps-iex.json
exec squadrn hook guard-git
stdout '"permissionDecision":"ask"'
stdin ps-ok.json
exec squadrn hook guard-git
! stdout .
stdin other-tool.json
exec squadrn hook guard-git
stdout '"permissionDecision":"ask"'
stdout 'does not know the Python tool'

# Broken input never fails open.
stdin garbage.txt
exec squadrn hook guard-git
stdout '"permissionDecision":"ask"'

# A broken config file falls back to the default list instead of disabling the guard.
cp broken.toml home/.config/squadrn/config.toml
stdin force.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'

exitcode 2 squadrn hook notify
exitcode 2 squadrn hook guard-git extra
exitcode 2 squadrn hook
exitcode 2 squadrn hook bogus
exitcode 2 squadrn hook git

# Layer 2: git's pre-push hook judges the exact refs, whatever command started the push.
rm home/.config/squadrn/config.toml
exec git init -q --bare remote.git
exec git -C feat commit -q --allow-empty -m one
exec git -C feat remote add origin ../remote.git
exec git -C feat push -q origin feat-x
exec sh -c 'git -C feat rev-parse HEAD > head.txt'
exec sh -c 'printf "refs/heads/feat-x %s refs/heads/main %s\n" "$(cat head.txt)" 0000000000000000000000000000000000000000 > pp-main.txt'
exec sh -c 'printf "refs/heads/feat-x %s refs/heads/feat-x %s\n" "$(cat head.txt)" "$(cat head.txt)" > pp-feat.txt'
cd feat
stdin ../pp-main.txt
! exec squadrn hook git pre-push origin ../remote.git
stderr 'squadrn guard: direct push to protected branch "main"'
stdin ../pp-feat.txt
exec squadrn hook git pre-push origin ../remote.git
cd $WORK
grep 'deny\tpre-push\t.*feat\tdirect push to protected branch "main"' home/.local/state/squadrn/guard.log

# The repository's own hook still runs after the check, with the same input.
cp repo-hook feat/.git/hooks/pre-push
chmod 755 feat/.git/hooks/pre-push
cd feat
stdin ../pp-feat.txt
! exec squadrn hook git pre-push origin ../remote.git
stderr 'repo hook saw refs/heads/feat-x'
cd $WORK
rm feat/.git/hooks/pre-push

# Other hooks only chain to the repository's own.
cd feat
exec squadrn hook git post-commit
cd $WORK

# Through git itself, with core.hooksPath pointing at the installed shims.
mkdir rel
exec sh -c 'cp "$(command -v squadrn)" rel/squadrn && cp -R "$REPO_ROOT/plugin" "$REPO_ROOT/.claude-plugin" rel/'
exec squadrn self-install rel
exists home/.local/share/squadrn/git-hooks/pre-push
! exec git -C feat -c core.hooksPath=$HOME/.local/share/squadrn/git-hooks push origin feat-x:main
stderr 'squadrn guard: direct push to protected branch "main"'
exec git -C feat -c core.hooksPath=$HOME/.local/share/squadrn/git-hooks push -q origin feat-x:feat-y

# The shims pass the config file baked in at install: the pushing process's environment cannot
# point the hook at a weaker policy, and an explicit --config file is honoured.
grep ' hook git --config .*/.config/squadrn/config.toml.* pre-push ' home/.local/share/squadrn/git-hooks/pre-push
mkdir evil/squadrn
cp evil-config evil/squadrn/config.toml
env XDG_CONFIG_HOME=$WORK/evil
! exec git -C feat -c core.hooksPath=$HOME/.local/share/squadrn/git-hooks push origin feat-x:main
stderr 'squadrn guard: direct push to protected branch "main"'
env XDG_CONFIG_HOME=
cd feat
stdin ../pp-feat.txt
! exec squadrn hook git --config ../strict-config pre-push origin ../remote.git
stderr 'direct push to protected branch "feat-x"'
cd $WORK

# The strict profile's ConfigChange hook appends one line to the audit log and never blocks.
env CLAUDE_CONFIG_DIR=$HOME/.claude-work
stdin configchange.json
exec squadrn hook config-change
exec cat $HOME/.local/state/squadrn/config-changes.log
stdout '"source":"user_settings"'
stdout '"file":"/x/settings.json"'
stdout '"config_dir":".*/.claude-work"'
exitcode 2 squadrn hook config-change extra
env CLAUDE_CONFIG_DIR=

-- evil-config --
protected_branches = ["nothing"]
-- strict-config --
protected_branches = ["feat-x"]
-- allow.json --
{"cwd":"feat","tool_input":{"command":"npm test && git push -u origin feat-x"}}
-- force.json --
{"cwd":"feat","tool_input":{"command":"git push -f origin feat-x"}}
-- token.json --
{"cwd":"feat","tool_input":{"command":"git push https://u:s3cr3t@github.com/o/r main"}}
-- dynamic.json --
{"cwd":"feat","tool_input":{"command":"git push origin \"$BRANCH\""}}
-- prod-main.json --
{"cwd":"prod","tool_input":{"command":"git push origin main"}}
-- prod-disable.json --
{"cwd":"prod","tool_input":{"command":"git config squadrn.protectedBranches none && git push origin main"}}
-- repo-hook --
#!/bin/sh
read l _ _ _
echo "repo hook saw $l" >&2
exit 1
-- prod-production.json --
{"cwd":"prod","tool_input":{"command":"git push origin production"}}
-- feat-staging.json --
{"cwd":"feat","tool_input":{"command":"git push origin staging"}}
-- staging.toml --
protected_branches = ["main", "staging"]
-- broken.toml --
protected_branches = [
-- ps-force.json --
{"cwd":"feat","tool_name":"PowerShell","tool_input":{"command":"& git push -f origin feat-x"}}
-- ps-iex.json --
{"cwd":"feat","tool_name":"PowerShell","tool_input":{"command":"iex ('git pu'+'sh')"}}
-- ps-ok.json --
{"cwd":"feat","tool_name":"PowerShell","tool_input":{"command":"Get-ChildItem; git push -u origin feat-x"}}
-- other-tool.json --
{"cwd":"feat","tool_name":"Python","tool_input":{"command":"print(1)"}}
-- garbage.txt --
not json
-- configchange.json --
{"hook_event_name":"ConfigChange","source":"user_settings","file_path":"/x/settings.json"}
