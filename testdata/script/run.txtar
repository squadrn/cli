[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Bare squadrn without a terminal runs claude as main, with CLAUDE_CONFIG_DIR removed
# even when the caller's environment sets it.
env CLAUDE_CONFIG_DIR=/should/be/removed
exec squadrn
stdout '^cfg=<unset> args=$'
env CLAUDE_CONFIG_DIR=

mkdir home/.claude-personal

# Account selection: name, provider/name, -a, --account=
exec squadrn personal
stdout '^cfg=.*/home/.claude-personal args=$'
exec squadrn claude/personal -p hi
stdout '^cfg=.*/home/.claude-personal args=-p hi$'
exec squadrn -a personal --resume abc
stdout '^cfg=.*/home/.claude-personal args=--resume abc$'
exec squadrn --account=personal
stdout '^cfg=.*/home/.claude-personal args=$'
exec squadrn main
stdout '^cfg=<unset> args=$'

# Prompts go after --; agent subcommands and flags pass through; unknown words are errors.
exec squadrn -- fix the bug
stdout '^cfg=<unset> args=fix the bug$'
exec squadrn personal -- doctor
stdout '^cfg=.*/home/.claude-personal args=doctor$'
exec squadrn 'fix the bug'
stdout '^cfg=<unset> args=fix the bug$'
exec squadrn mcp list
stdout '^cfg=<unset> args=mcp list$'
exec squadrn personal --version
stdout '^cfg=.*/home/.claude-personal args=--version$'
exitcode 2 squadrn fix the bug

# -C runs as if started elsewhere.
mkdir elsewhere
exec squadrn -C elsewhere -- here
grep 'pwd=.*/elsewhere args=here' home/calls.log
exitcode 2 squadrn -C missing-dir

# Exit codes: 2 usage, 1 runtime.
exitcode 2 squadrn -a
exitcode 2 squadrn -a Bad_Name
exitcode 1 squadrn -a ghost
! exec squadrn -a ghost
stderr 'account not found: claude/ghost \(run: squadrn account add claude/ghost\)'
-- home/.claude-personal/.squadrn-account --
