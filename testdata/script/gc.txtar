[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
mkdir repo/.claude
exec git -C repo worktree add -q -b worktree-feat-merged .claude/worktrees/feat-merged
exec git -C repo worktree add -q -b worktree-feat-open .claude/worktrees/feat-open
exec git -C repo/.claude/worktrees/feat-open commit -q --allow-empty -m wip
exec git -C repo worktree add -q -b worktree-fix-dirty .claude/worktrees/fix-dirty
cp empty repo/.claude/worktrees/fix-dirty/x
exec git -C repo worktree add -q -b other ../outside
exec git -C repo worktree add -q -b worktree-feat-busy .claude/worktrees/feat-busy
mkdir repo/.claude/worktrees/feat-busy/.squadrn-inuse repo/.claude/worktrees/feat-merged/build
cp inuse.json repo/.claude/worktrees/feat-busy/.squadrn-inuse/1.json
exec git -C repo worktree add -q -b worktree-feat-hidden .claude/worktrees/feat-hidden
exec git -C repo config status.showUntrackedFiles no
cp empty repo/.claude/worktrees/feat-hidden/untracked.txt
exec git -C repo worktree add -q -b keep-me .claude/worktrees/feat-foreign
exec sh -c 'printf "build/\n.squadrn-inuse/\n" >> repo/.git/info/exclude'
cp empty repo/.claude/worktrees/feat-merged/build/out.o

# Dry run classifies and removes nothing; worktrees outside .claude/worktrees are ignored.
cd repo
exec squadrn gc
stdout '^base: main$'
stdout 'remove +feat-merged +merged or no commits \(with 1 ignored path\(s\)\)'
stdout 'keep +feat-busy +in use by pid 1 \(claude/main\)'
stdout 'keep +feat-hidden +uncommitted changes'
stdout 'remove +feat-foreign +merged or no commits'
stdout 'keep +feat-open +unmerged commits'
stdout 'keep +fix-dirty +uncommitted changes'
! stdout outside
stdout 'dry run; re-run with --yes to remove'
exists .claude/worktrees/feat-merged

exec squadrn gc --yes
stdout 'removed 2 worktree\(s\)'
! exists .claude/worktrees/feat-merged
exists .claude/worktrees/feat-busy
exists .claude/worktrees/feat-hidden/untracked.txt
# Only branches named worktree-<name> are ever deleted.
exec git branch --list keep-me
stdout keep-me
exists .claude/worktrees/feat-open
exists .claude/worktrees/fix-dirty
exec git branch --list worktree-feat-merged
! stdout .

# From inside a worktree, gc still works on the main checkout.
cd .claude/worktrees/feat-open
exec squadrn gc
stdout 'keep +feat-open'

exec squadrn gc
stdout '^  keep  feat-open +unmerged commits$'
stdout '^nothing to remove$'
! stdout 'dry run'
exec squadrn gc --yes
stdout '^nothing to remove$'
! stdout 'removed 0'

exec squadrn gc --json
stdout '"action": "keep"'
stdout '"name": "feat-open"'
stdout '"ignored": 0'
stdout '"removed": false'
stdout '"errors": \[\]'

# --json --yes reports what was removed, as JSON only.
exec git -C $WORK/repo worktree add -q -b worktree-feat-two .claude/worktrees/feat-two
exec squadrn gc --json --yes
stdout '"base": "main"'
stdout '"name": "feat-two",(\n.*){5}"removed": true'
stdout '"errors": \[\]'
! stdout 'removed 1'
! exists $WORK/repo/.claude/worktrees/feat-two

# wt ls and wt rm.
cd $WORK/repo
exec squadrn wt ls
stdout '^feat-open +worktree-feat-open +clean +-$'
stdout '^fix-dirty +worktree-fix-dirty +modified +-$'
exec squadrn wt ls --json
stdout '"dirty": true'
! exec squadrn wt rm fix-dirty
stderr '^srn: fix-dirty has uncommitted changes or untracked files .*remove it anyway with --force$'
! stderr '/'
exists .claude/worktrees/fix-dirty
exec squadrn wt rm fix-dirty --force --yes
! exists .claude/worktrees/fix-dirty

# A worktree a session uses is kept unless --force, which says why it asks.
! exec squadrn wt rm feat-busy
stderr 'feat-busy is in use by pid 1 \(claude/main\); stop it first \(or use --force\)'
exitcode 2 squadrn wt rm feat-busy --force
! exec squadrn wt rm feat-busy --force
stderr 'remove feat-busy \(in use by pid 1 \(claude/main\)\); re-run with --yes'
! stderr 'uncommitted'
exec squadrn wt rm feat-busy --force --yes
! exists .claude/worktrees/feat-busy

# An unmerged branch is refused before anything is removed; --force-branch removes both.
! exec squadrn wt rm feat-open
stderr 'feat-open has commits that are not merged \(branch worktree-feat-open\); .*--force-branch'
exists .claude/worktrees/feat-open
exitcode 2 squadrn wt rm feat-open --force-branch
! exec squadrn wt rm feat-open --force-branch
stderr 'remove feat-open \(unmerged commits on worktree-feat-open\)'
exec squadrn wt rm feat-open --force-branch --yes
stdout 'removed worktree feat-open'
stdout 'deleted branch worktree-feat-open'
! exists .claude/worktrees/feat-open
exec git branch --list worktree-feat-open
! stdout .

# A branch left without its worktree: merged, it is deleted like an attached one; unmerged, it
# needs --force-branch.
exec git branch worktree-feat-done
exec squadrn wt rm feat-done
stdout '^deleted branch worktree-feat-done$'
exec git branch --list worktree-feat-done
! stdout .
exec git worktree add -q -b worktree-feat-orphan .claude/worktrees/feat-orphan
exec git -C .claude/worktrees/feat-orphan commit -q --allow-empty -m wip
exec git worktree remove .claude/worktrees/feat-orphan
! exec squadrn wt rm feat-orphan
stderr 'worktree feat-orphan is gone, but its branch worktree-feat-orphan with unmerged commits is left; delete it with --force-branch'
exitcode 2 squadrn wt rm feat-orphan --force-branch
exec squadrn wt rm feat-orphan --force-branch -y
stdout '^deleted branch worktree-feat-orphan$'
exec git branch --list worktree-feat-orphan
! stdout .

# A merged branch goes with its worktree.
exec git worktree add -q -b worktree-feat-merged2 .claude/worktrees/feat-merged2
exec squadrn wt rm feat-merged2
stdout 'removed worktree feat-merged2'
stdout 'deleted branch worktree-feat-merged2'
exitcode 1 squadrn wt rm nope
! exec squadrn wt rm nope
stderr '^srn: worktree not found: nope$'
exitcode 2 squadrn wt rm Bad_Name

cd $WORK
exitcode 1 squadrn gc
cd repo
exitcode 2 squadrn gc extra

-- empty --
-- inuse.json --
{"pid":1,"account":"claude/main"}
