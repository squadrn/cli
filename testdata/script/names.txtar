[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# A fresh machine (no options) gets the default names: srn + squadrn.
mkdir rel
exec sh -c 'cp "$(command -v squadrn)" rel/squadrn && cp -R "$REPO_ROOT/plugin" "$REPO_ROOT/.claude-plugin" rel/'
exec squadrn self-install rel
stdout 'installed squadrn dev → ~/.local/share/squadrn/bin/squadrn'
stdout 'linked ~/.local/bin/srn'
stdout 'linked ~/.local/bin/squadrn'
stdout 'next: srn doctor'
grep '^command = "srn"' home/.config/squadrn/config.toml
grep '^aliases = \["squadrn"\]' home/.config/squadrn/config.toml
exec sh -c 'readlink home/.local/bin/srn && readlink home/.local/bin/squadrn'
stdout -count=2 'home/.local/share/squadrn/bin/squadrn$'

# Choosing the default alias as the command on a fresh machine swaps the two names.
env HOME=$WORK/full
env XDG_CONFIG_HOME=$WORK/full/.config
env XDG_DATA_HOME=$WORK/full/.local/share
env XDG_STATE_HOME=$WORK/full/.local/state
env XDG_CACHE_HOME=$WORK/full/.cache
mkdir full/.claude
exec squadrn self-install rel --command squadrn
grep '^command = "squadrn"' full/.config/squadrn/config.toml
grep '^aliases = \["srn"\]' full/.config/squadrn/config.toml
exec squadrn self-install rel --command ai
grep '^command = "ai"' full/.config/squadrn/config.toml
grep '^aliases = \["srn"\]' full/.config/squadrn/config.toml

# Choosing no alias at install is respected.
env HOME=$WORK/bare
env XDG_CONFIG_HOME=$WORK/bare/.config
env XDG_DATA_HOME=$WORK/bare/.local/share
env XDG_STATE_HOME=$WORK/bare/.local/state
env XDG_CACHE_HOME=$WORK/bare/.cache
mkdir bare/.claude
exec squadrn self-install rel --alias ''
stdout 'linked ~/.local/bin/srn'
! stdout 'local/bin/squadrn'

# An install from before srn was the default keeps its names; the documented commands switch them.
env HOME=$WORK/old
env XDG_CONFIG_HOME=$WORK/old/.config
env XDG_DATA_HOME=$WORK/old/.local/share
env XDG_STATE_HOME=$WORK/old/.local/state
env XDG_CACHE_HOME=$WORK/old/.cache
mkdir old/.claude old/.config/squadrn
cp old.toml old/.config/squadrn/config.toml
exec squadrn self-install rel
stdout 'linked ~/.local/bin/squadrn'
stdout 'next: squadrn doctor'
exec squadrn config set command srn
stdout '^command: squadrn → srn \(aliases: squadrn\)$'

exec squadrn config set aliases squadrn
! stdout .
exec squadrn config set aliases squadrn,sq
stdout '^aliases: squadrn, sq \(removed: none, added: sq\)$'
! stdout 'command:'
exec squadrn config set aliases squadrn
grep '^command = "srn"' old/.config/squadrn/config.toml
grep '^aliases = \["squadrn"\]' old/.config/squadrn/config.toml
exec sh -c 'readlink old/.local/bin/srn && readlink old/.local/bin/squadrn'
stdout -count=2 'old/.local/share/squadrn/bin/squadrn$'

# Re-running the installer on such an install with --command srn swaps the names too.
env HOME=$WORK/flag
env XDG_CONFIG_HOME=$WORK/flag/.config
env XDG_DATA_HOME=$WORK/flag/.local/share
env XDG_STATE_HOME=$WORK/flag/.local/state
env XDG_CACHE_HOME=$WORK/flag/.cache
mkdir flag/.claude flag/.config/squadrn
cp old.toml flag/.config/squadrn/config.toml
exec squadrn self-install rel
exec squadrn self-install rel --command srn
stdout '^command: squadrn → srn \(aliases: squadrn\)$'
stdout 'next: srn doctor'
grep '^command = "srn"' flag/.config/squadrn/config.toml
grep '^aliases = \["squadrn"\]' flag/.config/squadrn/config.toml
exec sh -c 'readlink flag/.local/bin/srn && readlink flag/.local/bin/squadrn'
stdout -count=2 'flag/.local/share/squadrn/bin/squadrn$'

# The same at the installer's prompt: answering srn offers the old command as the alias.
env HOME=$WORK/tty
env XDG_CONFIG_HOME=$WORK/tty/.config
env XDG_DATA_HOME=$WORK/tty/.local/share
env XDG_STATE_HOME=$WORK/tty/.local/state
env XDG_CACHE_HOME=$WORK/tty/.cache
mkdir tty/.claude tty/.config/squadrn
cp old.toml tty/.config/squadrn/config.toml
exec squadrn self-install rel
env SQUADRN_TEST_TTY=$WORK/srn-answers
exec squadrn self-install rel --interactive
stderr 'Command name \[squadrn\]: '
stderr 'Short alias \[squadrn\] '
! stderr 'must differ'
stdout '^command: squadrn → srn \(aliases: squadrn\)$'
grep '^command = "srn"' tty/.config/squadrn/config.toml
grep '^aliases = \["squadrn"\]' tty/.config/squadrn/config.toml
env SQUADRN_TEST_TTY=

-- old.toml --
schema = 1
command = "squadrn"
aliases = ["srn"]
-- srn-answers --
srn

