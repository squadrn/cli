[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Golden outputs pin macOS/Linux behaviour (ADR 0008).
# After an intended change: go test ./internal/cli -run TestScript/golden -update, then review.

# Help of every command.
exec squadrn --help
cmp stdout help-root.txt
exec squadrn account --help
cmp stdout help-account.txt
exec squadrn account ls --help
cmp stdout help-account-ls.txt
exec squadrn account add --help
cmp stdout help-account-add.txt
exec squadrn account login --help
cmp stdout help-account-login.txt
exec squadrn account logout --help
cmp stdout help-account-logout.txt
exec squadrn account adopt --help
cmp stdout help-account-adopt.txt
exec squadrn account rename --help
cmp stdout help-account-rename.txt
exec squadrn account rm --help
cmp stdout help-account-rm.txt
exec squadrn usage --help
cmp stdout help-usage.txt
exec squadrn usage setup --help
cmp stdout help-usage-setup.txt
exec squadrn wt --help
cmp stdout help-wt.txt
exec squadrn wt ls --help
cmp stdout help-wt-ls.txt
exec squadrn wt rm --help
cmp stdout help-wt-rm.txt
exec squadrn grid --help
cmp stdout help-grid.txt
exec squadrn grid ls --help
cmp stdout help-grid-ls.txt
exec squadrn grid attach --help
cmp stdout help-grid-attach.txt
exec squadrn grid stop --help
cmp stdout help-grid-stop.txt
exec squadrn ps --help
cmp stdout help-ps.txt
exec squadrn swap --help
cmp stdout help-swap.txt
exec squadrn gc --help
cmp stdout help-gc.txt
exec squadrn deps --help
cmp stdout help-deps.txt
exec squadrn doctor --help
cmp stdout help-doctor.txt
exec squadrn config --help
cmp stdout help-config.txt
exec squadrn config get --help
cmp stdout help-config-get.txt
exec squadrn config set --help
cmp stdout help-config-set.txt
exec squadrn self-update --help
cmp stdout help-self-update.txt
exec squadrn self-uninstall --help
cmp stdout help-self-uninstall.txt
exec squadrn version --help
cmp stdout help-version.txt
exec squadrn completion --help
cmp stdout help-completion.txt

# Shell completion scripts.
exec squadrn completion bash
cmp stdout completion-bash.txt
exec squadrn completion zsh
cmp stdout completion-zsh.txt
exec squadrn completion fish
cmp stdout completion-fish.txt

# Plugin hook configuration (Unix keeps it byte for byte; only the matcher may change).
cmp $REPO_ROOT/plugin/hooks/hooks.json hooks.json

# Install layout after self-install.
mkdir rel home/.local/bin
exec sh -c 'cp "$(command -v squadrn)" rel/squadrn && cp -R "$REPO_ROOT/plugin" "$REPO_ROOT/.claude-plugin" rel/'
exec squadrn self-install rel
tree home/.local/share/squadrn
cmp stdout layout-data.txt
tree home/.local/bin
cmp stdout layout-bin.txt
tree home/.config/squadrn
cmp stdout layout-config.txt

-- help-root.txt --
Squadrn runs coding agents (today: Claude Code) as one of several accounts on this machine.

Accounts are provider/name: claude/main is ~/.claude, claude/personal is ~/.claude-personal.

Usage:
  srn [<account>] [<command> | agent args... | -- prompt] [flags]
  srn [command]

Examples:
  srn                                  pick an account interactively
  srn personal                         run as claude/personal (also: -a personal, claude/personal)
  srn personal -p "hi"                 agent flags go to the agent CLI
  srn personal -- "fix the bug"        a prompt goes after --
  srn account add work                 create claude/work, then: srn account login work
  srn grid ~/repo feat-a personal:fix-b  two agents side by side

Agents:
  deps           Install dependencies in a worktree (package manager from its lockfile)
  gc             Remove clean worktrees that are merged or empty (dry run without --yes)
  grid           Run agents side by side in a tmux grid, one worktree each
  ps             List running agents: session, account, worktree
  swap           Move a conversation to another account and resume it there
  wt             Run the agent in worktree <name> of this repository (Claude: .claude/worktrees/<name>)

Accounts:
  account        Manage agent accounts (default: ls)
  usage          Show each account's usage limits and which one to use next

Setup:
  completion     Generate the autocompletion script for the specified shell
  config         Show settings; get or set one (command and aliases relink ~/.local/bin)
  doctor         Check the install, the push guard, hooks and every account (or one)
  help           Help about any command
  self-uninstall Remove squadrn: plugin from every account, command links, completions, installed files
  self-update    Update squadrn and its plugin in every account
  setup          Guided first run: agent CLIs, default profile, existing accounts, usage tracking, doctor
  version        Print the squadrn version

Flags:
  -a, --account string   account to run as (provider/name or name)
  -C, --dir string       run as if started in this directory
  -h, --help             help for srn
      --no-color         disable colors (also: NO_COLOR=1)

Use "srn [command] --help" for more information about a command.
-- help-account.txt --
Manage agent accounts (default: ls)

Usage:
  srn account [flags]
  srn account [command]

Available Commands:
  add         Create or repair an account (settings, shared files, push guard, usage, login)
  adopt       Make an existing config dir (e.g. ~/.claude-<name>) an account and set it up
  login       Sign an account in
  logout      Sign an account out (keeps its dir)
  ls          List accounts with login status
  rename      Rename an account (logs it out first; log in again afterwards)
  rm          Log an account out and move its dir to the trash (--purge: delete it for good)

Flags:
  -h, --help   help for account
      --json   print JSON

Global Flags:
  -a, --account string   account to run as (provider/name or name)
  -C, --dir string       run as if started in this directory
      --no-color         disable colors (also: NO_COLOR=1)

Use "srn account [command] --help" for more information about a command.
