[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Golden outputs for macOS and Linux (ADR 0008: behaviour frozen across the Windows work).
# After an intended change: go test ./internal/cli -run TestScript/golden -update, then review.

# Help of every command.
exec sprawl --help
cmp stdout help-root.txt
exec sprawl account --help
cmp stdout help-account.txt
exec sprawl account ls --help
cmp stdout help-account-ls.txt
exec sprawl account add --help
cmp stdout help-account-add.txt
exec sprawl account login --help
cmp stdout help-account-login.txt
exec sprawl account logout --help
cmp stdout help-account-logout.txt
exec sprawl account rename --help
cmp stdout help-account-rename.txt
exec sprawl account rm --help
cmp stdout help-account-rm.txt
exec sprawl wt --help
cmp stdout help-wt.txt
exec sprawl wt ls --help
cmp stdout help-wt-ls.txt
exec sprawl wt rm --help
cmp stdout help-wt-rm.txt
exec sprawl grid --help
cmp stdout help-grid.txt
exec sprawl grid ls --help
cmp stdout help-grid-ls.txt
exec sprawl grid attach --help
cmp stdout help-grid-attach.txt
exec sprawl grid stop --help
cmp stdout help-grid-stop.txt
exec sprawl ps --help
cmp stdout help-ps.txt
exec sprawl swap --help
cmp stdout help-swap.txt
exec sprawl gc --help
cmp stdout help-gc.txt
exec sprawl deps --help
cmp stdout help-deps.txt
exec sprawl doctor --help
cmp stdout help-doctor.txt
exec sprawl config --help
cmp stdout help-config.txt
exec sprawl config get --help
cmp stdout help-config-get.txt
exec sprawl config set --help
cmp stdout help-config-set.txt
exec sprawl self-update --help
cmp stdout help-self-update.txt
exec sprawl self-uninstall --help
cmp stdout help-self-uninstall.txt
exec sprawl version --help
cmp stdout help-version.txt
exec sprawl completion --help
cmp stdout help-completion.txt

# Shell completion scripts.
exec sprawl completion bash
cmp stdout completion-bash.txt
exec sprawl completion zsh
cmp stdout completion-zsh.txt
exec sprawl completion fish
cmp stdout completion-fish.txt

# Plugin hook configuration (Unix keeps it byte for byte; only the matcher may change).
cmp $REPO_ROOT/plugin/hooks/hooks.json hooks.json

# Install layout after self-install.
mkdir rel home/.local/bin
exec sh -c 'cp "$(command -v sprawl)" rel/sprawl && cp -R "$REPO_ROOT/plugin" "$REPO_ROOT/.claude-plugin" rel/'
exec sprawl self-install rel
tree home/.local/share/sprawl
cmp stdout layout-data.txt
tree home/.local/bin
cmp stdout layout-bin.txt
tree home/.config/sprawl
cmp stdout layout-config.txt

-- help-root.txt --
sprawl runs coding agents (today: Claude Code) as one of several accounts on this machine.

Accounts are provider/name: claude/main is ~/.claude, claude/personal is ~/.claude-personal.

Usage:
  sprawl [<account>] [<command> | agent args... | -- prompt] [flags]
  sprawl [command]

Examples:
  sprawl                          pick an account interactively
  sprawl personal                 run as claude/personal (also: -a personal, claude/personal)
  sprawl personal -p "hi"         agent flags go to the agent CLI
  sprawl personal -- "fix the bug"  a prompt goes after --
  sprawl account add work         create claude/work, then: sprawl account login work
  sprawl grid ~/repo feat-a personal:fix-b

Agents:
  deps           Install dependencies in a worktree (package manager from its lockfile)
  gc             Remove clean worktrees that are merged or empty (dry run without --yes)
  grid           tmux grid for <repo>, one agent per pane in its own worktree; re-running adds panes
  ps             List running agents: session, account, worktree
  swap           Move a worktree's latest conversation to <account> and resume it there
  wt             Run the agent in worktree <name> of this repository (Claude: .claude/worktrees/<name>)

Accounts:
  account        Manage agent accounts (default: ls)

Setup:
  completion     Generate the autocompletion script for the specified shell
  config         Show settings; get or set one (command and aliases relink ~/.local/bin)
  doctor         Check the install, the push guard, hooks and every account
  help           Help about any command
  self-uninstall Remove sprawl: plugin from every account, command links, completions, installed files
  self-update    Update sprawl and its plugin in every account (--check: only look, --rollback: undo)
  version        Print the sprawl version

Flags:
  -a, --account string   account to run as (provider/name or name)
  -C, --dir string       run as if started in this directory
  -h, --help             help for sprawl
      --no-color         disable colors (also: NO_COLOR=1)

Use "sprawl [command] --help" for more information about a command.
-- help-account.txt --
Manage agent accounts (default: ls)

Usage:
  sprawl account [flags]
  sprawl account [command]

Available Commands:
  add         Create or repair an account (shared links, allowlisted MCP, plugin)
  adopt       Make an existing config dir (e.g. ~/.claude-<name>) an account
  login       Sign an account in
  logout      Sign an account out (keeps its dir)
  ls          List accounts with login status
  rename      Rename an account (logs it out first; log in again afterwards)
  rm          Log an account out and move its dir to the trash

Flags:
  -h, --help   help for account
      --json   print JSON

Global Flags:
  -a, --account string   account to run as (provider/name or name)
  -C, --dir string       run as if started in this directory
      --no-color         disable colors (also: NO_COLOR=1)

Use "sprawl account [command] --help" for more information about a command.
