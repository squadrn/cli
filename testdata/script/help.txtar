exec sprawl version
stdout '^sprawl dev$'
exitcode 2 sprawl version extra

exec sprawl --version
stdout '^sprawl dev$'
exec sprawl version --json
stdout '"version": "dev"'

exec sprawl --help
stdout 'runs coding agents \(today: Claude Code\) as one of several accounts'
stdout '^Agents:$'
stdout '^  wt +Run the agent in worktree'
stdout '^  grid +tmux grid'
stdout '^Accounts:$'
stdout '^  account +Manage agent accounts'
stdout '^Setup:$'
stdout '^  doctor +Check the install'
stdout '^  self-update +Update sprawl'
stdout '^  completion +'
stdout 'sprawl personal -- "fix the bug"'
! stdout 'self-install'
! stdout '^  hook '

exec sprawl account --help
stdout 'ls +List accounts'
stdout 'logout +Sign an account out'
stdout 'rename +Rename an account'
stdout 'rm +Log an account out'

# Typos are usage errors with suggestions, never prompts for the agent.
exitcode 2 sprawl acount ls
! exec sprawl acount ls
stderr 'unknown command or account "acount" \(did you mean account\?\)'
stderr 'sprawl -- "acount"'
exitcode 2 sprawl account lss
! exec sprawl account lss
stderr 'unknown account command "lss" \(did you mean ls\?\)'

# Completion scripts for every supported shell.
exec sprawl completion zsh
stdout '#compdef sprawl'
exec sprawl completion bash
stdout 'bash completion V2 for sprawl'
exec sprawl completion fish
stdout 'complete -c sprawl'
exec sprawl __complete ''
stdout '^account'
stdout '^claude/main'

# A bad config file is reported, not ignored.
! exec sprawl account add work
stderr 'unknown key "shared_mpc"'

-- home/.config/sprawl/config.toml --
shared_mpc = ["typo"]
