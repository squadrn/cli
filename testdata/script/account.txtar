[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Fixture: main has shared files, a per-account synced skills dir and user MCP servers.
mkdir home/.claude/agents home/.claude/skills/find-skills home/.claude/skills/synced
cp settings.json home/.claude/settings.json
cp empty home/.claude/CLAUDE.md
cp claude.json home/.claude.json
cp empty home/.claude/.loggedin

# add plans, applies and verifies: settings from main + the standard profile, links, allowlisted
# MCP (never entries carrying env), the plugin; without a terminal nothing is asked.
env SQUADRN_MARKETPLACE=$WORK/market
env FAKE_VERSION=2.1.329
cp onboarded.json home/.claude.json
exec squadrn account add claude/work
stdout '^Claude Code 2.1.329 · new account claude/work → ~/.claude-work$'
stdout '^  profile        standard \(secrets denied, push guard, 30-day history\)$'
stdout '^  shared         skills, CLAUDE.md, agents from claude/main$'
stdout '^✓ created ~/.claude-work \(private\)$'
stdout '^✓ settings from claude/main \+ standard profile$'
stdout '^✓ mcp codegraph from claude/main$'
stdout '^! mcp secret not copied'
stdout '^! mcp absent is not configured in claude/main$'
stdout '^✓ push guard: pre-tool hook \+ git pre-push$'
stdout '^done in [0-9.]+s · log in: srn account login claude/work · check: srn doctor claude/work$'
! stdout 'synced|usage tracking'
exists home/.claude-work/agents
! exists home/.claude-work/skills/synced
exec sh -c 'ls -a home | grep -c tmp- || true'
stdout '^0$'
grep '"Read\(~/.ssh/\*\*\)"' home/.claude-work/settings.json
grep '"Bash\(git push \*\)"' home/.claude-work/settings.json
grep '"Read\(~/.claude/.credentials.json\)"' home/.claude-work/settings.json
grep '"Edit\(~/.config/squadrn/\*\*\)"' home/.claude-work/settings.json
grep '"profile": "standard"' home/.claude-work/.squadrn-managed.json
grep '"hasCompletedOnboarding": true' home/.claude-work/.claude.json
! grep 'mcpServers' home/.claude-work/.claude.json

# add is idempotent: a second run says so and changes nothing.
exec squadrn account add work
stdout '^Claude Code 2.1.329 · claude/work → ~/.claude-work$'
stdout '^✓ claude/work is up to date$'
stdout '^done in .* · check: srn doctor claude/work$'
! stdout '^✓ (linked|mcp|push guard|created)'

# A new account's profile denies reading the credential files of the other accounts.
exec squadrn account add other --profile minimal --with privacy,no-attribution -y
stdout '^  profile        minimal \(secrets denied\) \+ privacy, no-attribution$'
stdout '^✓ settings from claude/main \+ minimal profile \+ privacy, no-attribution$'
grep '"DISABLE_TELEMETRY": "1"' home/.claude-other/settings.json
grep '"commit": ""' home/.claude-other/settings.json
! grep 'Bash\(git push' home/.claude-other/settings.json
exec squadrn work -- hi
grep '"Read\(~/.claude-other/.credentials.json\)"' home/.claude-work/settings.json
exec squadrn account rm other --yes
exitcode 2 squadrn account add x1 --profile lax
exitcode 2 squadrn account add x1 --with nope
exitcode 2 squadrn account add x1 --login --no-login
! exists home/.claude-x1

# A step that fails says which, what state the account is in and how to retry.
chmod 0500 home
! exec squadrn account add broken
stdout '^✗ create ~/.claude-broken failed: '
stdout '^  state: nothing was created$'
stdout '^  retry: srn account add claude/broken$'
chmod 0700 home
! exists home/.claude-broken

# Removing a shared item from main removes the link instead of leaving it dangling.
rm home/.claude/agents
exec squadrn account add work
stdout 'removed stale link ~/.claude-work/agents'
! exists home/.claude-work/agents

# ls shows main first and login state.
cp empty home/.claude-work/.loggedin
exec squadrn account ls
stdout '^ACCOUNT +LOGIN +EMAIL +DIR$'
stdout '^claude/main +yes +me@.claude +~/.claude$'
stdout '^claude/work +yes +me@.claude-work +~/.claude-work$'
exec squadrn account
stdout '^claude/work '

exec squadrn account ls --json
stdout '"account": "claude/work"'
stdout '"logged_in": true'
exec squadrn account --json
stdout '"account": "claude/main"'

# Dirs named like accounts but not made by squadrn are not accounts; adopt makes them one.
mkdir home/.claude-tool
exec squadrn account ls
stdout '^unmanaged: ~/.claude-tool \(srn account adopt claude/tool\)$'
! stdout '^claude/tool '
exitcode 2 squadrn tool
! exec squadrn tool
stderr 'to make the existing dir an account: srn account adopt tool'
! stderr 'account add'
! exec squadrn -a claude/tool
stderr 'account not found: claude/tool; its dir exists but is not a squadrn account \(run: srn account adopt claude/tool\)'
! exec squadrn account add tool
stderr 'exists but is not a squadrn account .*run: srn account adopt tool$'
exitcode 2 squadrn account adopt tool
exec squadrn account adopt tool --yes
stdout '^adopted claude/tool \(~/.claude-tool\)$'
stdout '^Claude Code 2.1.329 · claude/tool → ~/.claude-tool$'
stdout '^✓ settings from claude/main$'
stdout '^✓ linked ~/.claude-tool/CLAUDE.md$'
exists home/.claude-tool/.squadrn-account
exec squadrn account adopt tool
stdout 'already an account'
exitcode 1 squadrn account adopt ghost --yes
exec squadrn account ls
! stdout unmanaged

# A session refreshes per-skill links and warns about a shared item replaced by a file.
mkdir home/.claude/skills/new-skill
rm home/.claude/skills/find-skills
exec squadrn work
exists home/.claude-work/skills/new-skill
! exists home/.claude-work/skills/find-skills
rm home/.claude-work/CLAUDE.md
cp settings.json home/.claude-work/CLAUDE.md
exec squadrn work
stderr 'warning: ~/.claude-work/CLAUDE.md was replaced in claude/work, so it no longer follows the main account'
rm home/.claude-work/CLAUDE.md
exec squadrn account add work
stdout 'linked ~/.claude-work/CLAUDE.md'

# A session in progress blocks rename and rm unless --force.
mkdir home/.claude-work/.squadrn-inuse
cp inuse.json home/.claude-work/.squadrn-inuse/1.json
! exec squadrn account rename work job -y
stderr 'claude/work is in use by pid 1 \(claude/work\); stop it first \(or use --force\)'
! exec squadrn account rm work --yes
stderr 'in use by pid 1'
rm home/.claude-work/.squadrn-inuse/1.json

# A provider subcommand is a valid account name; the account is matched before the subcommand.
exec squadrn account add mcp --no-usage
exec squadrn mcp -- hi
stdout 'cfg=.*/.claude-mcp args=hi'
exec squadrn account rm mcp --yes
exec squadrn mcp list
stdout 'cfg=<unset> args=mcp list'

# login runs the agent's login and says who is logged in.
exec squadrn account login work
stdout '^logged in to claude/work as me@.claude-work$'
grep 'args=auth login' home/calls.log
exec squadrn account logout work
env FAKE_LOGIN_FAILS=1
! exec squadrn account login work
stderr 'claude/work is still not logged in; try again: srn account login claude/work'
env FAKE_LOGIN_FAILS=
exec squadrn account login work

# logout keeps the dir; rename logs out first, moves it and rewrites the plugin registry's paths.
exec squadrn account logout work
stdout 'logged out claude/work'
! exists home/.claude-work/.loggedin
exists home/.claude-work
mkdir home/.claude-work/plugins
exec sh -c 'printf "{\"installPath\":\"%s/.claude-work/plugins/cache/x\"}" "$HOME" > home/.claude-work/plugins/installed_plugins.json'
cp empty home/.claude-work/.loggedin
exitcode 2 squadrn account rename work job
mkdir home/.local/state/squadrn/usage
cp settings.json home/.local/state/squadrn/usage/claude-work.json
exec squadrn account rename work job -y
stdout 'renamed claude/work → claude/job \(~/.claude-job\), logged out'
stdout 'next: srn account login claude/job'
! exists home/.claude-work
! exists home/.claude-job/.loggedin
grep '.claude-job/plugins/cache/x' home/.claude-job/plugins/installed_plugins.json
exists home/.local/state/squadrn/usage/claude-job.json
! exists home/.local/state/squadrn/usage/claude-work.json
exitcode 2 squadrn account rename job grid
exitcode 2 squadrn account rename main x2
exitcode 1 squadrn account rename ghost x3
exec squadrn account rename job work -y
exists home/.local/state/squadrn/usage/claude-work.json

# Validation: invalid and reserved names are usage errors (2).
exitcode 2 squadrn account add Bad
exitcode 2 squadrn account add doctor
exitcode 2 squadrn account add main
exitcode 2 squadrn account add
exitcode 2 squadrn account frob
exitcode 2 squadrn account ls extra

# rm without a terminal needs --yes; main can never be removed.
exitcode 2 squadrn account rm work
exitcode 2 squadrn account rm main --yes
exec squadrn account rm claude/work --yes
[darwin] stdout 'removed account claude/work \(moved to ~/.Trash/.claude-work-'
[!darwin] stdout 'removed account claude/work \(moved to ~/.local/share/Trash/files/.claude-work-'
! exists home/.claude-work
! exists home/.local/state/squadrn/usage/claude-work.json
[darwin] exec sh -c 'ls -d home/.Trash/.claude-work-*'
[!darwin] exec sh -c 'cat home/.local/share/Trash/info/.claude-work-*.trashinfo'
[!darwin] stdout '^\[Trash Info\]$'
[!darwin] stdout '^Path=/.*/home/.claude-work$'
[!darwin] stdout '^DeletionDate=[0-9-]+T[0-9:]+$'
exitcode 1 squadrn account rm work --yes

-- onboarded.json --
{"hasCompletedOnboarding":true,"lastOnboardingVersion":"2.1.300","oauthAccount":{"emailAddress":"secret@x"},"mcpServers":{
  "codegraph":{"command":"codegraph","args":["serve","--mcp"]},
  "secret":{"command":"x","env":{"TOKEN":"t"}}}}
-- empty --
-- settings.json --
{}
-- claude.json --
{"mcpServers":{
  "codegraph":{"command":"codegraph","args":["serve","--mcp"]},
  "secret":{"command":"x","env":{"TOKEN":"t"}}}}
-- home/.config/squadrn/config.toml --
shared_mcp = ["codegraph", "secret", "absent"]
-- market/.claude-plugin/marketplace.json --
{"name":"squadrn","plugins":[]}
-- inuse.json --
{"pid":1,"account":"claude/work"}
