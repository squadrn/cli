[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# Fixture: main has shared files, a per-account synced skills dir and user MCP servers.
mkdir home/.claude/agents home/.claude/skills/find-skills home/.claude/skills/synced
cp settings.json home/.claude/settings.json
cp claude.json home/.claude.json
cp empty home/.claude/.loggedin

# add provisions links, allowlisted MCP (never entries carrying env) and the plugin.
env SPRAWL_MARKETPLACE=$WORK/market
exec sprawl account add claude/work
stdout '^account claude/work → ~/.claude-work$'
stdout 'linked ~/.claude-work/settings.json'
stdout 'linked ~/.claude-work/skills/find-skills'
! stdout 'synced'
stdout 'mcp added codegraph'
stdout 'mcp skipped secret'
stdout 'mcp missing absent'
stdout 'plugin installed sprawl@sprawl'
stdout 'next: sprawl account login claude/work'
exists home/.claude-work/agents
! exists home/.claude-work/skills/synced

# add is idempotent: a second run changes nothing.
exec sprawl account add work
! stdout 'linked|mcp added|plugin installed'

# Removing a shared item from main removes the link instead of leaving it dangling.
rm home/.claude/agents
exec sprawl account add work
stdout 'removed stale link ~/.claude-work/agents'
! exists home/.claude-work/agents

# ls shows main first and login state.
cp empty home/.claude-work/.loggedin
exec sprawl account ls
stdout '^ACCOUNT +LOGIN +EMAIL +DIR$'
stdout '^claude/main +yes +me@.claude +~/.claude$'
stdout '^claude/work +yes +me@.claude-work +~/.claude-work$'
exec sprawl account
stdout '^claude/work '

exec sprawl account ls --json
stdout '"account": "claude/work"'
stdout '"logged_in": true'
exec sprawl account --json
stdout '"account": "claude/main"'

# Dirs named like accounts but not made by sprawl are not accounts; adopt makes them one.
mkdir home/.claude-squad
exec sprawl account ls
stdout '^unmanaged: ~/.claude-squad \(sprawl account adopt claude/squad\)$'
! stdout '^claude/squad '
exitcode 2 sprawl squad
! exec sprawl account add squad
stderr 'exists but is not a sprawl account'
exitcode 2 sprawl account adopt squad
exec sprawl account adopt squad --yes
stdout 'adopted claude/squad'
exists home/.claude-squad/.sprawl-account
exec sprawl account adopt squad
stdout 'already an account'
exitcode 1 sprawl account adopt ghost --yes
exec sprawl account ls
! stdout unmanaged

# A session refreshes per-skill links and warns about a shared item replaced by a file.
mkdir home/.claude/skills/new-skill
rm home/.claude/skills/find-skills
exec sprawl work
exists home/.claude-work/skills/new-skill
! exists home/.claude-work/skills/find-skills
rm home/.claude-work/settings.json
cp settings.json home/.claude-work/settings.json
exec sprawl work
stderr 'warning: ~/.claude-work/settings.json was replaced in claude/work, so it no longer follows the main account'
rm home/.claude-work/settings.json
exec sprawl account add work
stdout 'linked ~/.claude-work/settings.json'

# A session in progress blocks rename and rm unless --force.
mkdir home/.claude-work/.sprawl-inuse
cp inuse.json home/.claude-work/.sprawl-inuse/1.json
! exec sprawl account rename work job
stderr 'claude/work is in use by pid 1 \(claude/work\); stop it first \(or use --force\)'
! exec sprawl account rm work --yes
stderr 'in use by pid 1'
rm home/.claude-work/.sprawl-inuse/1.json

# logout keeps the dir; rename logs out first, moves it and rewrites the plugin registry's paths.
exec sprawl account logout work
stdout 'logged out claude/work'
! exists home/.claude-work/.loggedin
exists home/.claude-work
mkdir home/.claude-work/plugins
exec sh -c 'printf "{\"installPath\":\"%s/.claude-work/plugins/cache/x\"}" "$HOME" > home/.claude-work/plugins/installed_plugins.json'
cp empty home/.claude-work/.loggedin
exec sprawl account rename work job
stdout 'renamed claude/work → claude/job \(~/.claude-job\), logged out'
stdout 'next: sprawl account login claude/job'
! exists home/.claude-work
! exists home/.claude-job/.loggedin
grep '.claude-job/plugins/cache/x' home/.claude-job/plugins/installed_plugins.json
exitcode 2 sprawl account rename job grid
exitcode 2 sprawl account rename main x2
exitcode 1 sprawl account rename ghost x3
exec sprawl account rename job work

# Validation: invalid and reserved names are usage errors (2).
exitcode 2 sprawl account add Bad
exitcode 2 sprawl account add mcp
exitcode 2 sprawl account add main
exitcode 2 sprawl account add
exitcode 2 sprawl account frob
exitcode 2 sprawl account ls extra

# rm without a terminal needs --yes; main can never be removed.
exitcode 2 sprawl account rm work
exitcode 2 sprawl account rm main --yes
exec sprawl account rm claude/work --yes
stdout 'removed account claude/work \(moved to ~/.local/share/Trash/files/.claude-work-'
! exists home/.claude-work
exec sh -c 'cat home/.local/share/Trash/info/.claude-work-*.trashinfo'
stdout '^\[Trash Info\]$'
stdout '^Path=/.*/home/.claude-work$'
stdout '^DeletionDate=[0-9-]+T[0-9:]+$'
exitcode 1 sprawl account rm work --yes

-- empty --
-- settings.json --
{}
-- claude.json --
{"mcpServers":{
  "codegraph":{"command":"codegraph","args":["serve","--mcp"]},
  "secret":{"command":"x","env":{"TOKEN":"t"}}}}
-- home/.config/sprawl/config.toml --
shared_mcp = ["codegraph", "secret", "absent"]
-- market/.claude-plugin/marketplace.json --
{"name":"sprawl","plugins":[]}
-- inuse.json --
{"pid":1,"account":"claude/work"}
