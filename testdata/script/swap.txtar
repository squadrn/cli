[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
mkdir repo/.claude home/.claude-personal
cp empty home/.claude/.loggedin
cp empty home/.claude-personal/.loggedin
exec git -C repo worktree add -q -b worktree-feat-s .claude/worktrees/feat-s
exec git -C repo worktree add -q -b worktree-feat-empty .claude/worktrees/feat-empty

# main holds an older conversation (with a subagent dir) for feat-s, keyed like Claude Code does.
exec sh -c 'key=$(cd repo/.claude/worktrees/feat-s && pwd -P | sed "s/[^A-Za-z0-9]/-/g"); echo "$key" > key.txt; d="$HOME/.claude/projects/$key"; mkdir -p "$d/sid-1/subagents" && echo "{}" > "$d/sid-1.jsonl" && echo a > "$d/sid-1/subagents/a.jsonl" && touch -t 202601010000 "$d/sid-1.jsonl"'

# Not in a grid: copy to the target account and resume in this terminal, inside the worktree.
cd repo
exec squadrn swap --worktree feat-s --to personal
stdout 'swap feat-s: claude/main → claude/personal \(session sid-1\)'
stdout '^cfg=.*/home/.claude-personal args=--resume sid-1$'
waitfor ../home/calls.log 'pwd=.*/repo/.claude/worktrees/feat-s args=--resume sid-1'
exec sh -c 'd="$HOME/.claude-personal/projects/$(cat ../key.txt)"; test -f "$d/sid-1.jsonl" && test -f "$d/sid-1/subagents/a.jsonl"'

# The newest conversation wins across accounts.
exec sh -c 'echo "{}" > "$HOME/.claude-personal/projects/$(cat ../key.txt)/sid-2.jsonl"'
exec squadrn swap --worktree feat-s --to claude/main
stdout 'swap feat-s: claude/personal → claude/main \(session sid-2\)'
stdout '^cfg=<unset> args=--resume sid-2$'

# Moving a conversation into another organization's account asks first.
cp $WORK/org-a $WORK/home/.claude/.org
cp $WORK/org-b $WORK/home/.claude-personal/.org
exec sh -c 'touch "$HOME/.claude/projects/$(cat ../key.txt)/sid-2.jsonl"'
exitcode 2 squadrn swap --worktree feat-s --to personal
! exec squadrn swap --worktree feat-s --to personal
stderr 'move the conversation from claude/main \(Org A\) to claude/personal \(Org B\), another organization; re-run with --yes'
rm $WORK/home/.claude-personal/.org
! exec squadrn swap --worktree feat-s --to personal
stderr 'move the conversation from claude/main \(Org A\) to claude/personal \(no organization\); re-run with --yes'
cp $WORK/org-b $WORK/home/.claude-personal/.org
exec squadrn swap --worktree feat-s --to personal --yes
stdout 'swap feat-s: claude/main → claude/personal'
rm $WORK/home/.claude/.org $WORK/home/.claude-personal/.org

# Errors. A logged-out target is refused.
rm $WORK/home/.claude-personal/.loggedin
exitcode 1 squadrn swap --worktree feat-s --to personal
! exec squadrn swap --worktree feat-s --to personal
stderr 'claude/personal is not logged in; run: srn account login claude/personal'
cp $WORK/empty $WORK/home/.claude-personal/.loggedin
exitcode 1 squadrn swap --worktree feat-nope --to personal
exitcode 1 squadrn swap --worktree feat-empty --to personal
exitcode 2 squadrn swap --worktree
exitcode 2 squadrn swap --worktree Bad --to personal
exitcode 1 squadrn swap --worktree feat-s --to ghost

# In a grid the pane is restarted in place; without a terminal that needs --yes.
exec squadrn grid . feat-s
exitcode 2 squadrn swap --worktree feat-s --to personal
exec squadrn swap --worktree feat-s --to personal --yes
stdout 'pane %[0-9]+ now runs feat-s as claude/personal'
exec tmux list-panes -s -t srn-repo -F '#{@squadrn_acct}:#{@squadrn_name}'
stdout '^claude/personal:feat-s$'
waitfor ../home/calls.log 'cfg=.*/home/.claude-personal pwd=.*/feat-s args=--resume sid-2'
exec tmux kill-server

-- empty --
-- org-a --
Org A
-- org-b --
Org B
-- home/.claude-personal/.squadrn-account --
