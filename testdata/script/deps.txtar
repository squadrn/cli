[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
mkdir repo/.claude/worktrees/feat-a repo/.claude/worktrees/feat-b
cp lock repo/.claude/worktrees/feat-a/pnpm-lock.yaml
cp lock repo/.claude/worktrees/feat-a/package-lock.json
cp fakepm bin/pnpm
chmod 755 bin/pnpm

# The first lockfile in priority order picks the package manager; it runs inside the worktree.
cd repo
exec squadrn deps feat-a
stdout '^pnpm install --frozen-lockfile --prefer-offline in .*/feat-a$'

exitcode 1 squadrn deps feat-b
! exec squadrn deps feat-b
stderr 'no supported lockfile'
exitcode 1 squadrn deps feat-none
exitcode 2 squadrn deps Bad

-- lock --
-- fakepm --
#!/bin/sh
echo "pnpm $* in $(pwd -P)"
