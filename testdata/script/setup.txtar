[windows] skip 'Unix script: sh, symlinks'
env FAKE_VERSION=2.1.329
cp empty home/.claude/.loggedin
mkdir home/.claude-tool

# Without a terminal setup changes nothing and says what it found and what to run.
exec squadrn setup
stdout '^agent CLIs: Claude Code 2.1.329 \(.*/claude\) · Codex CLI not found \(install: npm install -g @openai/codex\)$'
stdout '^accounts: claude/main \(to adopt: ~/.claude-tool\)$'
stdout '^next: srn setup \(guided'
! exists home/.config/squadrn/config.toml

# --yes takes the defaults: nothing adopted, usage tracking on, doctor runs.
exec squadrn setup -y
stdout '^1. agent CLIs$'
stdout '^   ✓ Claude Code 2.1.329'
stdout '^   – Codex CLI not found'
stdout '^   profile        standard'
stdout '^   – skipped ~/.claude-tool \(later: srn account adopt claude/tool\)$'
stdout '^   ✓ agents cannot edit squadrn.s files \(permissions.deny in ~/.claude/settings.json\)$'
stdout '^   ✓ usage tracking on: claude/main$'
stdout '^5. doctor$'
# Doctor's groups and checks are indented under the step like the other steps' lines.
stdout '^   install$'
stdout '^     ✓ agents cannot edit squadrn.s files \(permissions.deny\)$'
stdout '^next: srn account add <name>'
! exists home/.claude-tool/.squadrn-account
grep 'hook statusline' home/.claude/settings.json
grep '"Edit\(~/.local/share/squadrn/\*\*\)"' home/.claude/settings.json

# It is idempotent.
exec squadrn setup -y
! stdout '^   ✓ agents cannot edit'
stdout '^   ✓ on for every account that reports usage$'

# Codex on PATH and a codex dir named like an account are found too.
cp $CODEX_FAKE bin/codex
mkdir home/.codex-ci
exec squadrn setup
stdout '· Codex CLI 2.1.329 \(.*/codex\)$'
stdout '^accounts: claude/main \(to adopt: ~/.claude-tool, ~/.codex-ci\)$'
rm bin/codex

# The first install runs it at a terminal (SQUADRN_TEST_TTY stands in for the controlling one):
# strict as the default profile, adopt the dir.
env HOME=$WORK/fresh
env XDG_CONFIG_HOME=$WORK/fresh/.config
env XDG_DATA_HOME=$WORK/fresh/.local/share
env XDG_STATE_HOME=$WORK/fresh/.local/state
env XDG_CACHE_HOME=$WORK/fresh/.cache
mkdir fresh/.claude fresh/.claude-old
env SQUADRN_TEST_TTY=$WORK/answers
env SQUADRN_TEST_VERSION=1.0.0
env PATH=$WORK/fresh/.local/bin:$PATH
release rel
exec $WORK/rel/squadrn self-install rel --interactive --command srn --alias sqx
stdout 'installed squadrn'
# Doctor checks the installed copy, not the unpacked release the installer runs.
stderr '  ✓ installed release 1.0.0$'
stderr '  ✓ srn on PATH$'
! stderr 'different program'
stderr '^set up squadrn \(every step can be skipped'
stderr '^   profiles       minimal   secrets denied$'
stderr 'profile        minimal / standard / strict \[standard\]: '
stderr 'adopt ~/.claude-old as claude/old\? \(another tool may own it\) \[y/N\] '
stderr '   ✓ new accounts get the strict profile$'
stderr 'protect +deny agents edits of squadrn.s files in ~/.claude/settings.json\? \[Y/n\] '
stderr '   – skipped \(later: srn doctor shows the rules to add\)$'
stderr 'adopted claude/old$'
stderr 'track +usage limits for claude/main, claude/old\? \[Y/n\] '
stderr '– skipped \(later: srn usage setup --all\)$'
grep '^default_profile = "strict"' fresh/.config/squadrn/config.toml
exists fresh/.claude-old/.squadrn-account

# An update never runs it.
exec squadrn self-install rel --interactive --command srn
! stdout 'set up squadrn'
stdout 'next: srn doctor'

-- empty --
-- answers --
strict
n
y
n
