[windows] skip 'Unix script: sh, tmux, symlinks or mode bits'
# main: logged in with the plugin; personal: logged out, no plugin, a broken shared link.
mkdir home/.claude-personal home/.claude/agents
cp empty home/.claude/.loggedin
cp plugins.json home/.claude/.plugins
cp settings.json home/.claude/settings.json
cp empty home/.claude/CLAUDE.md
exec sh -c 'ln -s /elsewhere home/.claude-personal/agents && ln -s /gone home/.claude-personal/hooks'

! exec squadrn doctor
stdout '^install$'
stdout '✓ git'
stdout '! claude .* at .* is not the native build'
! stdout '✓ claude'
stdout '! squadrn plugin files not installed'
stdout '^settings & hooks$'
stdout '✓ settings.json valid'
stdout '✗ hook not executable: .*/missing-hook.sh'
stdout '! Stop runs "notify" 2 times'
stdout '^push guard$'
stdout '✗ layer 1 \(pre-tool hook\): squadrn is not installed'
stdout '! layer 2 \(git pre-push hook\) is not installed'
stdout '! agents can edit squadrn.s own files  → add to permissions.deny in ~/.claude/settings.json: \["Edit\(~/.local/share/squadrn/\*\*\)"'
stdout '! ~/.claude-personal is readable by other users'
stdout '^account claude/main$'
stdout '✓ logged in as me@.claude'
stdout '✓ squadrn plugin enabled'
stdout '! srn not on PATH'
stdout '^account claude/personal$'
stdout '✗ not logged in  → srn account login claude/personal'
stdout '✗ squadrn plugin not installed \(no git push guard\)  → srn account repair claude/personal'
stdout '✗ agents is not linked to main  → srn account repair claude/personal --relink$'
stdout '! CLAUDE.md is not linked to main yet  → srn account repair claude/personal$'
stdout '! dangling link hooks  → srn account repair claude/personal'
stdout '[0-9]+ problem\(s\), [0-9]+ warning\(s\)$'
exitcode 1 squadrn doctor
exitcode 2 squadrn doctor a b
exitcode 1 squadrn doctor ghost
! exec squadrn doctor --json
stdout '"status": "fail"'
stdout '"group": "push guard"'
exec sh -c 'chmod 700 home/.claude-personal'
! exec squadrn doctor
! stdout 'readable by other users'
# A shared file main gained later is linked by the next session.
exec squadrn personal -- hi
! exec squadrn doctor
! stdout 'CLAUDE.md is not linked'


-- empty --
-- plugins.json --
[{"id":"squadrn@squadrn","enabled":true}]
-- settings.json --
{"hooks":{
  "PreToolUse":[{"hooks":[{"type":"command","command":"$HOME/missing-hook.sh"}]}],
  "Stop":[{"hooks":[{"type":"command","command":"notify"},{"type":"command","command":"notify"}]}]}}
-- home/.claude-personal/.squadrn-account --
