[windows] skip 'Unix script: symlinks'
release rel

# Without a terminal --interactive asks nothing and installs the defaults.
exec squadrn self-install rel --interactive
! stderr 'Command name'
stdout 'linked ~/.local/bin/squadrn'
stdout 'linked ~/.local/bin/srn'

# With a terminal (SQUADRN_TEST_TTY stands in for it) the current names are the defaults; a
# reinstall with other names removes the old ones.
env SQUADRN_TEST_TTY=$WORK/answers
exec squadrn self-install rel --interactive
stderr 'Command name \[srn\]: '
stderr 'Short alias \[squadrn\] \(''-'' for none\): '
stderr 'invalid command name "con": it is a reserved device name on Windows'
stdout '^command: srn → ai; aliases: sx$'
exists home/.local/bin/ai
exists home/.local/bin/sx
! exists home/.local/bin/squadrn
! exists home/.local/bin/srn
grep '^command = "ai"' home/.config/squadrn/config.toml

# Enter keeps the names: nothing to report.
env SQUADRN_TEST_TTY=$WORK/enter
exec squadrn self-install rel --interactive
stderr 'Command name \[ai\]: '
stderr 'Short alias \[sx\]'
! stdout 'command:'

# Name flags skip the prompt; self-update and rollback never prompt.
exec squadrn self-install rel --interactive --command ai
! stderr 'Command name'
exec squadrn self-update --rollback
! stderr 'Command name'

# A fresh home gets completions for the login shell in a dir made for them; install and update
# never edit ~/.zshrc, they say how zsh loads the dir.
env SHELL=/bin/zsh
exec squadrn self-install rel --interactive --command ai
stdout '^  zsh completion → ~/.zsh/completions \(zsh does not load it yet; run: ai completion install\)$'
exists home/.zsh/completions/_ai
! exists home/.zshrc
! stdout 'bash completion|fish completion'
# Once ~/.zshrc puts the dir on fpath before compinit, the hint is gone.
cp zshrc home/.zshrc
exec squadrn self-install rel --interactive --command ai
stdout '^  zsh completion → ~/.zsh/completions$'
# completion = off: updates leave completion alone.
exec squadrn config set completion off
exec squadrn self-install rel --interactive --command ai
! stdout 'zsh completion'
exec squadrn config set completion auto
env SHELL=

-- zshrc --
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit
-- answers --
con
ai
sx
-- enter --


