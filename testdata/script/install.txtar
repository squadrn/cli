[windows] skip 'Unix script: symlinks'
release rel

# Without a terminal --interactive asks nothing and installs the defaults.
exec squadrn self-install rel --interactive
! stderr 'Command name'
stdout 'linked ~/.local/bin/squadrn'
stdout 'linked ~/.local/bin/srn'

# With a terminal (SQUADRN_TEST_TTY stands in for it) the current names are the defaults; a
# reinstall with other names removes the old ones.
env SQUADRN_TEST_TTY=$WORK/answers
exec squadrn self-install rel --interactive
stderr 'Command name \[squadrn\]: '
stderr 'Short alias \[srn\] \(''-'' for none\): '
stderr 'invalid command name "con": it is a reserved device name on Windows'
stdout '^command: squadrn → ai \(removed: squadrn, srn, added: ai, sx\)$'
exists home/.local/bin/ai
exists home/.local/bin/sx
! exists home/.local/bin/squadrn
! exists home/.local/bin/srn
grep '^command = "ai"' home/.config/squadrn/config.toml

# Enter keeps the names: nothing to report.
env SQUADRN_TEST_TTY=$WORK/enter
exec squadrn self-install rel --interactive
stderr 'Command name \[ai\]: '
stderr 'Short alias \[sx\]'
! stdout 'command:'

# Name flags skip the prompt; self-update and rollback never prompt.
exec squadrn self-install rel --interactive --command ai
! stderr 'Command name'
exec squadrn self-update --rollback
! stderr 'Command name'

-- answers --
con
ai
sx
-- enter --


