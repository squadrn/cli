[windows] skip 'Unix script: sh, symlinks or mode bits'
mkdir elsewhere

# Globals right after the account are squadrn's, not the agent's.
exec squadrn personal -C elsewhere --no-color -- here
stdout '^cfg=.*/home/.claude-personal args=here$'
grep 'pwd=.*/elsewhere args=here' home/calls.log
exec squadrn personal --dir=elsewhere -p hi
stdout 'args=-p hi$'
exitcode 2 squadrn personal -a main
! exec squadrn personal -a main
stderr 'the account is given twice'

# Commands that do not run as an account refuse one instead of ignoring it.
exitcode 2 squadrn personal doctor
! exec squadrn personal config
stderr '^squadrn: config does not take an account$'
! exec squadrn -a personal wt ls
stderr 'wt ls does not take an account'
! exec squadrn personal grid --spread repo a b
stderr '--spread picks the accounts itself'

# JSON for --version and config get.
exec squadrn --version --json
stdout '"version": "dev"'
exec squadrn config get update_channel --json
stdout '"key": "update_channel"'
stdout '"value": "stable"'

# Values an environment variable overrides are marked.
env SQUADRN_SHARED_MCP='a b'
exec squadrn config
stdout '^shared_mcp +a,b  \(from SQUADRN_SHARED_MCP\)$'
env SQUADRN_SHARED_MCP=
exec squadrn config set --help
stdout 'restores the default protected_branches'

# An invalid config keeps the git-level guard on for sessions and says so once.
release rel
exec squadrn self-install rel
cp printenv bin/claude
chmod 755 bin/claude
cp bad.toml home/.config/squadrn/config.toml
exec squadrn -- hi
stdout 'GIT_CONFIG_VALUE_0=.*git-hooks'
stderr -count=1 'warning: config .*unknown key "colour"; the git push guard stays on'
! exec squadrn doctor
stdout 'config invalid: config .*unknown key "colour"'

-- printenv --
#!/bin/sh
case "$*" in
  "auth status") echo '{"loggedIn":true}'; exit 0 ;;
  "plugin "*) echo '[]'; exit 0 ;;
esac
env | grep '^GIT_CONFIG' | sort
-- bad.toml --
colour = "blue"
-- home/.claude-personal/.squadrn-account --
