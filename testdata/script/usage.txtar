[windows] skip 'Unix script: sh, symlinks'
# Fixture: main (max, acme) with its own status line; work has its own copy of main's settings.
cp settings.json home/.claude/settings.json
cp empty home/.claude/.loggedin
cp max home/.claude/.plan
cp acme home/.claude/.org
exec squadrn account add work --no-usage
! stdout 'usage tracking'
cp empty home/.claude-work/.loggedin
cp acme home/.claude-work/.org

# Fake notifiers record what the limit hook would show.
cp notifier bin/osascript
cp notifier bin/notify-send
chmod 755 bin/osascript
chmod 755 bin/notify-send

# Without data nothing is an error.
exec squadrn usage
stdout '^ACCOUNT +PLAN +ORG +5H +RESETS +7D +RESETS +STATE +SEEN$'
stdout '^claude/main +max +acme +- +- +- +- +nodata +-$'
stdout '^claude/work +- +acme +- +- +- +- +nodata +-$'
stdout 'not tracked: claude/main, claude/work \(run: srn usage setup --all\)$'
# A logged-out account is not listed as untracked.
rm home/.claude-work/.loggedin
exec squadrn usage --refresh
stdout '^claude/work .*loggedout'
stdout 'not tracked: claude/main \(run: srn usage setup claude/main\)$'
cp empty home/.claude-work/.loggedin
exec squadrn usage --refresh

# Setup asks first; without a terminal it needs --yes.
exitcode 2 squadrn usage setup
exitcode 2 squadrn usage --undo
exitcode 2 squadrn usage setup a b
exitcode 2 squadrn usage setup --all work
exec squadrn usage setup --all -y
stdout '^usage tracking on: ~/.claude/settings.json \(claude/main\)$'
stdout '^usage tracking on: ~/.claude-work/settings.json \(claude/work\)$'
grep '"command": ".*/squadrn hook statusline --then .echo mine; printf ' home/.claude/settings.json
grep '"padding": 2' home/.claude/settings.json
grep '"model": "opus"' home/.claude/settings.json
grep '"command": ".*/squadrn hook statusline --then .echo mine; printf ' home/.claude-work/settings.json
exec sh -c 'test ! -L home/.claude-work/settings.json'
# The session-start sync keeps squadrn's status line and does not report it as a user change.
exec squadrn work -- hi
! stderr 'kept your change'
grep 'hook statusline' home/.claude-work/settings.json

# Setting it up again changes nothing.
cp home/.claude/settings.json before.json
exec squadrn usage setup work
stdout '^usage tracking already on: ~/.claude-work/settings.json \(claude/work\)$'
cmp home/.claude/settings.json before.json
exec squadrn usage setup --all -y
stdout 'already on'
exec squadrn account add work
! stdout 'usage tracking'

# A new account copies main's status line: --no-usage takes the recorder out and keeps it out,
# tracking says so either way.
exec squadrn account add nouse --no-usage --no-login
stdout '^✓ usage tracking off$'
grep '"command": "echo mine; printf ' home/.claude-nouse/settings.json
! grep 'hook statusline' home/.claude-nouse/settings.json
exec squadrn account add nouse --no-login
! stdout 'usage tracking'
! grep 'hook statusline' home/.claude-nouse/settings.json
exec squadrn account add use --usage --no-login
stdout '^✓ usage tracking on$'
grep 'hook statusline' home/.claude-use/settings.json
exec squadrn account rm nouse --yes
exec squadrn account rm use --yes

# The wrapped command still runs, with the same input, and its output and exit status pass through.
stdin status.json
exec squadrn hook statusline --then 'echo mine; printf ''%s'' x'
stdout '^mine$'
stdout '^x$'
stdin status.json
! exec squadrn hook statusline --then 'cat; exit 3'
stdout '"session_id":"s1"'
exists home/.local/state/squadrn/usage/claude-main.json

# Without --then it prints a compact line for the account in CLAUDE_CONFIG_DIR.
env CLAUDE_CONFIG_DIR=$HOME/.claude-work
stdin status.json
exec squadrn hook statusline
stdout '^work · 5h 42% · 7d 18%$'
grep '"used_pct": 42' home/.local/state/squadrn/usage/claude-work.json
grep '"cwd": "/repo"' home/.local/state/squadrn/usage/claude-work.json
stdin nolimits.json
exec squadrn hook statusline
stdout '^work · 5h 42% · 7d 18%$'

# An unknown config dir is not recorded; broken input still prints.
env CLAUDE_CONFIG_DIR=$WORK/elsewhere
stdin status.json
exec squadrn hook statusline
stdout '^5h 42% · 7d 18%$'
! exists home/.local/state/squadrn/usage/claude-elsewhere.json
stdin garbage.txt
exec squadrn hook statusline
stdout '^$'
exitcode 2 squadrn hook statusline --bogus
exitcode 2 squadrn hook limit extra

# A turn stopped by the usage limit is recorded and notified.
exec sh -c 'sed "s#WORKDIR#$WORK#" limit.tmpl > limit.json'
env CLAUDE_CONFIG_DIR=$HOME/.claude-work
stdin limit.json
exec squadrn hook limit
grep '"limited_session": "s2"' home/.local/state/squadrn/usage/claude-work.json
grep '"reset_estimate"' home/.local/state/squadrn/usage/claude-work.json
grep 'claude/work hit its usage limit \(resets (Mon |Tue |Wed |Thu |Fri |Sat |Sun )?15:45\) — srn swap' notified.txt
stdin other-error.json
exec squadrn hook limit
env CLAUDE_CONFIG_DIR=

# The table and JSON show the limit and the best account for the repository it happened in.
mkdir repo
cd repo
exec squadrn usage
stdout '^claude/work +- +acme +42% .* +18% .* +limited +just now$'
stdout '^best for this repo: claude/main$'
exec squadrn usage --json
stdout '"from": "claude/work"'
stdout '"best": "claude/main"'
stdout '"state": "limited"'
stdout '"tracking": true'
stdout '"used_pct": 42'
stdout '"session": "s2"'
exec squadrn usage work
stdout '^state +limited$'
stdout '^limit hit +just now, resets .*15:45$'
stdout '^tracking +on$'
stdout '^best for this repo: claude/main$'
exec squadrn usage work --json
stdout '"account": "claude/work"'
! stdout '"accounts"'
! exec squadrn usage nobody
cd $WORK
exitcode 2 squadrn usage --watch --json

# Doctor reports tracking per account.
exec sh -c 'squadrn doctor > doctor.txt || true'
grep 'usage tracking: on' doctor.txt

# --undo restores the previous command, once.
exec squadrn usage setup --undo --all -y
stdout '^usage tracking off: ~/.claude/settings.json \(claude/main\)$'
stdout '^usage tracking off: ~/.claude-work/settings.json \(claude/work\)$'
! grep 'hook statusline' home/.claude-work/settings.json
grep '"command": "echo mine; printf ''%s'' x"' home/.claude/settings.json
! grep 'hook statusline' home/.claude/settings.json
exec squadrn usage setup --undo -y
stdout 'not set up'

# An adopted account with its own settings and no status line gets main's, wrapped; undo puts
# main's command back.
mkdir home/.claude-solo
cp emptyobj home/.claude-solo/settings.json
exec squadrn account adopt solo --yes
stdout '^adopted claude/solo \(~/.claude-solo\)$'
exec squadrn account add solo --usage
stdout '^✓ usage tracking on$'
grep '"command": ".* hook statusline --then .echo mine' home/.claude-solo/settings.json
exec squadrn usage setup --undo solo -y
grep '"command": "echo mine; printf ''%s'' x"' home/.claude-solo/settings.json
exitcode 2 squadrn account add solo --usage --no-usage

# --all asks once and names every settings file with the accounts it covers.
! exec squadrn usage setup --all
stderr 'record usage limits through the status line of ~/.claude/settings.json \(claude/main\); ~/.claude-solo/settings.json \(claude/solo\); ~/.claude-work/settings.json \(claude/work\); re-run with --yes'
! grep 'hook statusline' home/.claude/settings.json

# self-uninstall puts every status line back.
exec squadrn usage setup --all -y
exec squadrn self-uninstall --yes
stdout 'restored the status line in ~/.claude/settings.json'
grep '"command": "echo mine; printf ''%s'' x"' home/.claude/settings.json

-- empty --
-- emptyobj --
{}
-- max --
max
-- acme --
acme
-- settings.json --
{
  "model": "opus",
  "statusLine": {"type": "command", "command": "echo mine; printf '%s' x", "padding": 2}
}
-- notifier --
#!/bin/sh
printf '%s\n' "$@" >> "$HOME/../notified.txt"
-- status.json --
{"session_id":"s1","cwd":"/repo","rate_limits":{"five_hour":{"used_percentage":42,"resets_at":4102444800},"seven_day":{"used_percentage":18.2,"resets_at":4102444800}}}
-- nolimits.json --
{"session_id":"s1","cwd":"/repo"}
-- limit.tmpl --
{"session_id":"s2","cwd":"WORKDIR/repo","hook_event_name":"StopFailure","error":"rate_limit","error_details":"429 Too Many Requests","last_assistant_message":"You've hit your session limit · resets 3:45pm"}
-- other-error.json --
{"session_id":"s3","cwd":"/x","error":"server_error"}
-- garbage.txt --
not json
