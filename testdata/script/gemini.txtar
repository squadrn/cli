[windows] skip 'Unix script: sh, symlinks or mode bits'
# Gemini CLI accounts: GEMINI_CLI_HOME homes holding the CLI's state in .gemini/, settings.json
# with comments, file-based auth, the push guard as a BeforeTool hook in each account's settings
# and no layer-2 push guard (ADR 0013).

# Without gemini on PATH and without gemini accounts, gemini stays out of the way.
cp empty home/.claude/.loggedin
! exec squadrn doctor
! stdout 'gemini not on PATH|✓ gemini|^account gemini'
cp $GEMINI_FAKE bin/gemini
cp node.sh bin/node
chmod 755 bin/node

# Main has a commented settings.json, a shared instruction file, a command, a skill and files
# that stay per account.
mkdir home/.gemini/skills/review home/.gemini/commands home/.gemini/policies home/.gemini/tmp
cp main-settings.jsonc home/.gemini/settings.json
cp gemini.md home/.gemini/GEMINI.md
cp empty home/.gemini/commands/fix.toml
cp empty home/.gemini/installation_id
cp empty home/.gemini/trustedFolders.json
exec squadrn account add gemini/work --no-login -y
stdout '^Gemini CLI 0.70.0 · new account gemini/work → ~/.gemini-work$'
stdout '^  shared         skills, GEMINI.md, commands from gemini/main$'
stdout '^✓ created ~/.gemini-work \(private\)$'
stdout '^✓ settings from gemini/main \+ standard profile$'
stdout '^! push guard: the squadrn plugin is not available here'
stdout 'log in: srn account login gemini/work'
! grep 'squadrn-hook' home/.gemini-work/.gemini/settings.json
# With the plugin files, the guard is a BeforeTool hook on the shell tool. Gemini sessions run no
# git hooks, so there is no git pre-push layer.
env SQUADRN_MARKETPLACE=$REPO_ROOT
exec squadrn account add gemini/work --no-login -y
stdout '^✓ push guard: pre-tool hook$'
grep '"matcher": "run_shell_command"' home/.gemini-work/.gemini/settings.json
grep '"name": "squadrn-guard"' home/.gemini-work/.gemini/settings.json
grep '"timeout": 5000' home/.gemini-work/.gemini/settings.json
grep '"enableNotifications": false' home/.gemini-work/.gemini/settings.json
# The standard profile: no yolo, no auto-update in parallel panes, 30-day history, git and tmux
# variables never redacted, worktrees on, and a policy file every session loads.
grep '"disableYoloMode": true' home/.gemini-work/.gemini/settings.json
grep '"enableAutoUpdate": false' home/.gemini-work/.gemini/settings.json
grep '"maxAge": "30d"' home/.gemini-work/.gemini/settings.json
grep '"GIT_CONFIG_VALUE_0"' home/.gemini-work/.gemini/settings.json
grep '"worktrees": true' home/.gemini-work/.gemini/settings.json
grep 'commandPrefix = "git push"' home/.gemini-work/.gemini/squadrn-policy.toml
grep 'decision = "ask_user"' home/.gemini-work/.gemini/squadrn-policy.toml
grep 'toolName = \["read_file", "read_many_files", "grep_search", "glob"\]' home/.gemini-work/.gemini/squadrn-policy.toml
grep 'reading ./.env is denied' home/.gemini-work/.gemini/squadrn-policy.toml
! exists home/.gemini/squadrn-policy.toml
! exists home/.gemini-work/.gemini/policies
grep '"command": "\\".*/plugin/bin/squadrn-hook\\" guard-git --no-ask --agent gemini"' home/.gemini-work/.gemini/settings.json
exec squadrn account add gemini/work --no-login -y
stdout '^✓ gemini/work is up to date$'

# The account dir is the GEMINI_CLI_HOME: squadrn's files there, the CLI's in .gemini/.
exists home/.gemini-work/.squadrn-account
exists home/.gemini-work/.squadrn-managed.json
exists home/.gemini-work/.gemini/GEMINI.md
exists home/.gemini-work/.gemini/commands
exists home/.gemini-work/.gemini/skills/review
exists home/.gemini-work/.gemini/settings.json
! exists home/.gemini-work/GEMINI.md
! exists home/.gemini-work/settings.json
! exists home/.gemini-work/.gemini/policies
! exists home/.gemini-work/.gemini/tmp
! exists home/.gemini-work/.gemini/installation_id
! exists home/.gemini-work/.gemini/trustedFolders.json
exec sh -c 'ls -a home | grep -c tmp- || true'
stdout '^0$'

# The account's copy is plain JSON merged from main's: comments, MCP servers and squadrn's own
# hook entries from main stay out; the user's other hooks, the auth type and the theme come along.
! grep '^ *//|/\*|mcpServers|/old/plugin' home/.gemini-work/.gemini/settings.json
grep -count=4 'squadrn-hook' home/.gemini-work/.gemini/settings.json
grep '"selectedType": "oauth-personal"' home/.gemini-work/.gemini/settings.json
grep '"theme": "GitHub"' home/.gemini-work/.gemini/settings.json
grep '"command": "my-linter"' home/.gemini-work/.gemini/settings.json
grep '"url": "https://example.com/a//b"' home/.gemini-work/.gemini/settings.json
# Main's commented file is never rewritten.
cmp home/.gemini/settings.json main-settings.jsonc

# Logged out until the token file holds a refresh token.
exec squadrn account ls
stdout '^gemini/work +no +- +~/.gemini-work$'
exec squadrn account login gemini/work
stdout 'finish the Google login in Gemini CLI, then type /quit'
stdout '^logged in to gemini/work as me@.gemini-work$'
grep 'cfg=.*/home/.gemini-work args=--skip-trust$' home/calls.log
exists home/.gemini-work/.gemini/oauth_creds.json
exec squadrn account ls
stdout '^gemini/work +yes +me@.gemini-work +~/.gemini-work$'
# A token file without a refresh token is not a login.
cp no-refresh.json home/.gemini-work/.gemini/oauth_creds.json
exec squadrn account ls
stdout '^gemini/work +no +'
cp creds.json home/.gemini-work/.gemini/oauth_creds.json
exec squadrn account ls
stdout '^gemini/work +yes +me@.gemini-work'

# Sessions run as the account, with the encrypted keychain storage switched off; main runs
# with GEMINI_CLI_HOME unset.
env GEMINI_FORCE_ENCRYPTED_FILE_STORAGE=true
exec squadrn gemini/work -p hi
stdout '^cfg=.*/home/.gemini-work args=--policy .*/home/.gemini-work/.gemini/squadrn-policy.toml -p hi$'
exec squadrn gemini/main -p hi
stdout '^cfg=<unset> args=-p hi$'
! grep 'encrypted-storage' home/calls.log
exec squadrn gemini/work mcp list
stdout '^cfg=.*/home/.gemini-work args=mcp list$'

# Other providers' profiles deny reading every Gemini credential file.
exec squadrn account add claude/work --no-usage --no-login -y
grep '"Read\(~/.gemini-work/.gemini/oauth_creds.json\)"' home/.claude-work/settings.json
grep '"Read\(~/.gemini-work/.gemini/google_accounts.json\)"' home/.claude-work/settings.json
grep '"Read\(~/.gemini-work/.gemini/gemini-credentials.json\)"' home/.claude-work/settings.json
grep '"Read\(~/.gemini/oauth_creds.json\)"' home/.claude-work/settings.json
exec squadrn account rm claude/work --yes

# doctor: the CLI and Node versions, the environment, the login, credentials and the missing
# layer-2 guard.
env GOOGLE_APPLICATION_CREDENTIALS=/k.json
! exec squadrn doctor gemini/work
stdout '✓ gemini 0.70.0'
stdout '✓ node v22.3.0 \(Gemini CLI\)'
stdout '! GEMINI_FORCE_ENCRYPTED_FILE_STORAGE is set'
stdout '! GOOGLE_APPLICATION_CREDENTIALS is set'
stdout '^account gemini/work$'
stdout '✓ logged in as me@.gemini-work'
stdout '✓ credentials kept in ~/.gemini-work/.gemini'
stdout '! no layer-2 push guard: Gemini CLI turns git hooks off'
stdout '✓ settings.json follows main \+ standard profile'
stdout '✓ push guard hook installed$'
env GEMINI_FORCE_ENCRYPTED_FILE_STORAGE= GOOGLE_APPLICATION_CREDENTIALS=
env FAKE_VERSION=0.69.2
! exec squadrn doctor gemini/work
stdout '! gemini 0.69.2 is older than 0.70.0, the oldest version squadrn supports  → npm install -g @google/gemini-cli'
env FAKE_VERSION=
cp old-node.sh bin/node
! exec squadrn doctor gemini/work
stdout '! node v18.19.0 is too old: Gemini CLI needs Node.js 20 or newer'
cp node.sh bin/node
cp empty home/.gemini-work/.gemini/gemini-credentials.json
! exec squadrn doctor gemini/work
stdout '✗ credentials may be shared with other accounts: gemini-credentials.json found'
rm home/.gemini-work/.gemini/gemini-credentials.json

# doctor reports a guard hook that is turned off, changed or missing; account add restores it.
cp settings-hooks-off.json home/.gemini-work/.gemini/settings.json
exec squadrn account add gemini/work --no-login -y
! exec squadrn doctor gemini/work
stdout '✗ push guard hook turned off or changed \(hooksConfig, matcher or command\) \(no git push guard\)  → srn account add gemini/work'
cp empty-object.json home/.gemini-work/.gemini/settings.json
exec squadrn account add gemini/work --no-login -y
exec sh -c 'sed "s/run_shell_command/write_file/" home/.gemini-work/.gemini/settings.json > s.json'
cp s.json home/.gemini-work/.gemini/settings.json
! exec squadrn doctor gemini/work
stdout '✗ push guard hook turned off or changed'
cp empty-object.json home/.gemini-work/.gemini/settings.json
! exec squadrn doctor gemini/work
stdout '✗ push guard hook not installed \(no git push guard\)  → srn account add gemini/work'
exec squadrn account add gemini/work --no-login -y
stdout '^✓ push guard: pre-tool hook$'
! exec squadrn doctor gemini/work
stdout '✓ push guard hook installed$'

# Notifications: BeforeAgent, AfterAgent and Notification hooks (2 s, no AfterTool), Gemini's own
# notifications off while squadrn's are on. The hook prints nothing and exits 0: output or exit 2
# on AfterAgent would make Gemini retry the turn.
grep -count=3 '"name": "squadrn-notify"' home/.gemini-work/.gemini/settings.json
grep -count=3 '"timeout": 2000' home/.gemini-work/.gemini/settings.json
! grep 'AfterTool' home/.gemini-work/.gemini/settings.json
env SQUADRN_TEST_NOTIFY=$WORK/sent.jsonl GEMINI_CLI_HOME=$WORK/home/.gemini-work
stdin gemini-permission.json
exec squadrn hook notify --agent gemini
! stdout .
grep '"title":"Gemini CLI · work · api","body":"Needs approval: run_shell_command","kind":"input","sound":true,"group":"g1"' sent.jsonl
stdin gemini-before.json
exec squadrn hook notify --agent gemini
! stdout .
stdin gemini-after.json
exec squadrn hook notify --agent gemini
! stdout .
grep '"body":"Done","kind":"done","group":"g2"' sent.jsonl
! grep 'secret plan' sent.jsonl
env SQUADRN_TEST_NOTIFY= GEMINI_CLI_HOME=

# ps falls back on the title Gemini gives its terminal when no hook reported a state.
exec tmux new-session -d -s g -x 80 -y 24 sleep 60
exec tmux set -p -t g @squadrn_acct gemini/work
exec tmux set -p -t g @squadrn_name feat-g
exec tmux select-pane -t g -T '✋ Action Required (api)'
exec squadrn ps
stdout '^gemini/work +feat-g +input +g %[0-9]+ '
exec tmux select-pane -t g -T '◇  Ready (api)'
exec squadrn ps
stdout '^gemini/work +feat-g +ready '
exec tmux kill-server

# A session keeps the account's guard hook while settings follow main.
exec squadrn gemini/work -p hi
grep -count=4 'squadrn-hook' home/.gemini-work/.gemini/settings.json

# The installed hook blocks a push with exit 2, Gemini's form.
exec sh -c 'grep -o "[^\"]*/plugin/bin/squadrn-hook" home/.gemini-work/.gemini/settings.json | head -1 > hookpath.txt'
stdin push-force.json
! exec sh -c '"$(cat hookpath.txt)" guard-git --no-ask --agent gemini'
! stdout .
stderr 'force push is not allowed'

# Main's settings.json has comments: squadrn does not rewrite it and says what to add.
! exec squadrn account add gemini/main --no-login --no-usage -y
stderr 'has comments squadrn does not rewrite: add these entries to its "hooks" yourself: \{"AfterAgent":.*"BeforeTool":'
cmp home/.gemini/settings.json main-settings.jsonc

# Other accounts' credential files are denied to the file tools too.
exec squadrn account add gemini/strict --profile strict --no-login -y
grep '"maxAge": "14d"' home/.gemini-strict/.gemini/settings.json
grep '"defaultApprovalMode": "default"' home/.gemini-strict/.gemini/settings.json
grep 'reading ~/.gemini-work/.gemini/oauth_creds.json is denied' home/.gemini-strict/.gemini/squadrn-policy.toml
exec squadrn account rm gemini/strict --purge --yes

# shared_mcp copies main's allowlisted servers into the account's settings.json, never one with
# env or headers.
env SQUADRN_SHARED_MCP='docs main-only absent'
exec squadrn account add gemini/mcp --no-login -y
stdout '^✓ mcp docs from gemini/main$'
stdout '^! mcp main-only not copied'
stdout '^! mcp absent is not configured in gemini/main$'
grep '"docs": \{' home/.gemini-mcp/.gemini/settings.json
! grep 'main-only' home/.gemini-mcp/.gemini/settings.json
exec squadrn account add gemini/mcp --no-login -y
! stdout 'mcp docs'
env SQUADRN_SHARED_MCP=
exec squadrn account rm gemini/mcp --purge --yes

# Folder trust is asked once per repository: yes trusts the repository root, and so every
# worktree below it, in that account's trustedFolders.json.
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
cp yes.txt tty.txt
env SQUADRN_TEST_TTY=$WORK/tty.txt
cd repo
exec squadrn gemini/work -p hi
stderr 'trust .*/repo in gemini/work\? Its settings, hooks and MCP servers apply'
stderr 'gemini/work trusts'
grep '"TRUST_FOLDER"' $WORK/home/.gemini-work/.gemini/trustedFolders.json
exec squadrn gemini/work -p hi
! stderr 'trust'
! grep 'GEMINI_CLI_TRUST_WORKSPACE' $WORK/home/calls.log

# srn wt runs gemini --worktree <name>, which creates .gemini/worktrees/<name>.
exec squadrn gemini/work wt feat-g
stdout '^cfg=.*/home/.gemini-work args=--policy .*squadrn-policy.toml --worktree feat-g$'
cd $WORK
env SQUADRN_TEST_TTY=

# A grid pane runs it too.
exec squadrn grid repo gemini/work:feat-h
stdout 'gemini/work +→ feat-h'
waitfor home/calls.log 'cfg=.*/home/.gemini-work pwd=.*/repo args=--policy .* --worktree feat-h'
exec tmux kill-server

# Logout moves the login files to the trash.
exec squadrn account logout gemini/work
[darwin] stdout '^moved the login files of gemini/work to the trash \(~/.Trash\)$'
[!darwin] stdout '^moved the login files of gemini/work to the trash \(~/.local/share/Trash/files\)$'
stdout '^logged out gemini/work$'
! exists home/.gemini-work/.gemini/oauth_creds.json
! exists home/.gemini-work/.gemini/google_accounts.json
[darwin] exec sh -c 'ls -a home/.Trash | grep -c "^.gemini-work-"'
[!darwin] exec sh -c 'ls -a home/.local/share/Trash/files | grep -c "^.gemini-work-"'
stdout '^2$'
[!darwin] exec sh -c 'cat home/.local/share/Trash/info/.gemini-work-oauth_creds.json-*.trashinfo'
[!darwin] stdout '^Path=.*/home/.gemini-work/.gemini/oauth_creds.json$'
exec squadrn account ls
stdout '^gemini/work +no +'
exec squadrn account logout gemini/work
stdout '^gemini/work holds no login$'

# Rename keeps a file-based login: it moves with the dir.
cp creds.json home/.gemini-work/.gemini/oauth_creds.json
exec squadrn account rename gemini/work job -y
stdout '^renamed gemini/work → gemini/job \(~/.gemini-job\)$'
! stdout 'logged out'
exists home/.gemini-job/.gemini/oauth_creds.json
exec squadrn account ls
stdout '^gemini/job +yes +'

# rm moves the whole account, login included, to the trash.
exec squadrn account rm gemini/job --yes
[darwin] stdout '^removed account gemini/job \(moved to ~/.Trash/.gemini-job-'
[!darwin] stdout '^removed account gemini/job \(moved to ~/.local/share/Trash/files/.gemini-job-'
! exists home/.gemini-job
exec squadrn account add gemini/tmp --no-login -y
exec squadrn account rm gemini/tmp --purge --yes
stdout '^deleted ~/.gemini-tmp$'
! exists home/.gemini-tmp

# self-uninstall takes the guard hook out of Gemini accounts, keeping their other settings; main's
# commented file is left for the user.
exec squadrn account add gemini/un --no-login -y
grep 'squadrn-hook' home/.gemini-un/.gemini/settings.json
exec squadrn self-uninstall --yes
stdout '^  gemini/un: push guard hook removed$'
stderr 'gemini/main: push guard hook uninstall: .*has comments squadrn does not rewrite: remove squadrn'
! grep 'squadrn' home/.gemini-un/.gemini/settings.json
grep '"theme": "GitHub"' home/.gemini-un/.gemini/settings.json
cmp home/.gemini/settings.json main-settings.jsonc

-- empty --
-- gemini.md --
# shared instructions
-- node.sh --
#!/bin/sh
echo v22.3.0
-- old-node.sh --
#!/bin/sh
echo v18.19.0
-- creds.json --
{"access_token":"a","refresh_token":"r","token_type":"Bearer"}
-- no-refresh.json --
{"access_token":"a","token_type":"Bearer"}
-- main-settings.jsonc --
// Main's settings, with comments Gemini accepts.
{
  "security": {
    "auth": { "selectedType": "oauth-personal" } // Google login
  },
  /* the theme */
  "ui": { "theme": "GitHub" },
  "general": { "url": "https://example.com/a//b" },
  "mcpServers": { "main-only": { "command": "srv", "env": { "TOKEN": "x" } }, "docs": { "command": "npx", "args": ["-y", "@acme/docs"] } },
  "hooks": {
    "BeforeTool": [
      { "matcher": "run_shell_command", "hooks": [{ "type": "command", "name": "squadrn-guard", "command": "\"/old/plugin/bin/squadrn-hook\" guard-git --no-ask --agent gemini" }] },
      { "matcher": "write_file", "hooks": [{ "type": "command", "command": "my-linter" }] }
    ]
  }
}
-- settings-hooks-off.json --
{"security": {"auth": {"selectedType": "oauth-personal"}}, "hooksConfig": {"enabled": false}}
-- empty-object.json --
{"security": {"auth": {"selectedType": "oauth-personal"}}}
-- push-force.json --
{"cwd":".","hook_event_name":"BeforeTool","tool_name":"run_shell_command","tool_input":{"command":"git push -f origin main","dir_path":"."}}
-- gemini-permission.json --
{"session_id":"g1","transcript_path":"/t","cwd":"/src/api","hook_event_name":"Notification","timestamp":"2026-11-21T10:00:00.000Z","notification_type":"ToolPermission","message":"Allow run_shell_command?","details":{"toolName":"run_shell_command"}}
-- gemini-before.json --
{"session_id":"g2","transcript_path":"/t","cwd":"/src/api","hook_event_name":"BeforeAgent","timestamp":"2026-11-21T10:00:00.000Z","prompt":"fix it"}
-- gemini-after.json --
{"session_id":"g2","transcript_path":"/t","cwd":"/src/api","hook_event_name":"AfterAgent","timestamp":"2026-11-21T10:00:05.000Z","prompt":"fix it","prompt_response":"secret plan","stop_hook_active":false}
-- yes.txt --
y
