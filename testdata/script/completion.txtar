[windows] skip 'Unix script: sh stub agents'
# Tab completion goes through squadrn's router: accounts by their shortest name first, then
# subcommands; after an account, what can follow it. It never runs an agent CLI: stub agents
# that leave a mark and fail stand first on PATH.
cp stub bin/claude
cp stub bin/codex
chmod 755 bin/claude
chmod 755 bin/codex
mkdir home/.claude-personal home/.claude-work home/.codex-work home/.codex
cp empty home/.claude-personal/.squadrn-account
cp empty home/.claude-work/.squadrn-account
cp empty home/.codex-work/.squadrn-account

# First word: accounts (bare name when it names only that account), then
# subcommands, in that order (KeepOrder + NoFileComp = 36).
exec squadrn __complete ''
stdout '\Amain\tclaude/main\npersonal\tclaude/personal\nclaude/work\tClaude Code\ncodex/main\tCodex CLI\ncodex/work\tCodex CLI\naccount\t'
stdout '^wt\tRun the agent'
stdout '^help\t'
stdout '^:36$'
! stdout '^__complete'

# A prefix filters; one no bare name matches is matched against provider/name.
exec squadrn __complete per
cmp stdout per.out
exec squadrn __complete wo
stdout '\A:36\n\z'
exec squadrn __complete co
stdout '\Acodex/main\tCodex CLI\ncodex/work\tCodex CLI\ncompletion\t'
exec squadrn __completeNoDesc cl
cmp stdout cl.out

# After an account: the subcommands that run as one, then the agent's own subcommands.
exec squadrn __complete personal ''
stdout '\Agrid\t.*\nwt\t.*\nagents\tClaude Code subcommand\n'
stdout '^mcp\tClaude Code subcommand$'
! stdout '^(account|doctor\t[^C]|help|personal)'
exec squadrn __complete codex/work ''
stdout '^exec\tCodex CLI subcommand$'
! stdout '^setup-token\t'
exec squadrn __complete -C . --no-color claude/personal --no-color m
cmp stdout m.out

# Then cobra completes the subcommand as usual.
exec squadrn __complete personal wt ''
stdout '^ls\t'
stdout '^:4$'
exec squadrn __complete -a personal wt ''
stdout '^ls\t'

# Values of the global flags: accounts for -a, directories for -C.
exec squadrn __complete -a ''
stdout '\Amain\tclaude/main\npersonal\t'
stdout '^:36$'
exec squadrn __complete --account per
stdout '\Apersonal\tclaude/personal\n:36\n'
exec squadrn __complete -C ''
stdout '\A:16\n'
exec squadrn __complete personal --dir ''
stdout '\A:16\n'

# Flags, prompts and the agent's own words.
exec squadrn __complete --
stdout '^--account\t'
exec squadrn __complete personal -- ''
stdout '\A:4\n'
exec squadrn __complete personal mcp ''
stdout '\A:0\n'
exec squadrn __complete -p ''
stdout '\A:0\n'
exec squadrn __complete typo ''
stdout '\A:4\n'
exec squadrn __complete personal -a work ''
stdout '\A:4\n'

# Descriptions add the login last cached, however old; no cache entry, no login shown.
mkdir home/.cache/squadrn
cp auth.json home/.cache/squadrn/auth.json
exec squadrn __complete ''
stdout '\Amain\tclaude/main · me@example.com\npersonal\tclaude/personal · logged out\nclaude/work\tClaude Code\n'
exec squadrn __complete -a co
stdout '^codex/main\tCodex CLI · logged in$'

# Accounts as arguments and flag values, other arguments: nothing rather than file names.
exec squadrn __complete doctor per
stdout '\Apersonal\tclaude/personal · logged out\n:36\n'
exec squadrn __complete usage setup per
stdout '\Apersonal\t'
exec squadrn __complete swap --to per
stdout '\Apersonal\t'
exec squadrn __complete swap ''
stdout '\A:4\n\z'
exec squadrn __complete gc ''
stdout '\A:4\n\z'

# config set: keys, then the values each accepts; list values comma separated.
exec squadrn __complete config set ''
stdout '^notify.events$'
exec squadrn __complete config set update_channel ''
cmp stdout channel.out
exec squadrn __complete config set git_hooks ''
stdout '\Atrue\nfalse\n:4\n'
exec squadrn __complete config set default_profile ''
stdout '\Aminimal\nstandard\nstrict\n'
exec squadrn __complete config set notify.events input,
cmp stdout events.out
exec squadrn __complete config set aliases ''
stdout '\A:6\n'

# Worktree names: those of the account's provider; grid takes a repository, then
# [<account>:]<name>.
exec git init -q -b main repo
exec git -C repo commit -q --allow-empty -m init
exec git -C repo worktree add -q .claude/worktrees/feat-a
exec git -C repo worktree add -q .gemini/worktrees/gem-a
cd repo
exec squadrn __complete wt rm ''
stdout '\Afeat-a\n:4\n'
exec squadrn __complete personal wt ''
stdout '^feat-a$'
cd $WORK
exec squadrn __complete -C repo wt ''
stdout '^feat-a$'
exec squadrn __complete grid ''
stdout '^attach\t'
stdout '^:16$'
exec squadrn __complete grid repo ''
stdout '\Afeat-a\nmain:\trun as claude/main · me@example.com\npersonal:\trun as claude/personal · logged out\n'
stdout '^:38$'
exec squadrn __complete grid repo personal:
stdout '\Apersonal:feat-a\n:36\n'
exec squadrn __complete grid attach ''
stdout '\A:16\n'
exec squadrn __complete grid stop repo ''
stdout '\A:4\n'

! exists agent-called

-- stub --
#!/bin/sh
touch "$HOME/../agent-called"
exit 1
-- empty --
-- auth.json --
{"claude/main":{"status":{"loggedIn":true,"email":"me@example.com"},"at":"2020-01-01T00:00:00Z"},
 "claude/personal":{"status":{"loggedIn":false},"at":"2020-01-01T00:00:00Z"},
 "codex/main":{"status":{"loggedIn":true},"at":"2020-01-01T00:00:00Z"},
 "claude/work":{"err":"down","at":"2020-01-01T00:00:00Z"}}
-- channel.out --
stable
beta
:4
-- events.out --
input,failed
input,done
input,info
:6
-- per.out --
personal	claude/personal
:36
-- cl.out --
claude/main
claude/personal
claude/work
:36
-- m.out --
mcp	Claude Code subcommand
migrate-installer	Claude Code subcommand
:36
