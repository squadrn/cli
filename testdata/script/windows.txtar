[!windows] skip 'Windows behaviour; the other scripts cover macOS and Linux'

# Sessions run claude.exe as a child: main without CLAUDE_CONFIG_DIR, other accounts with it.
mkdir home/.claude-personal
exec squadrn -- hi
stdout '^cfg=<unset> args=hi$'
exec squadrn personal -- hi
stdout '^cfg=.*home.\.claude-personal args=hi$'

# Accounts.
cp empty home/.claude/.loggedin
exec squadrn account ls
stdout '^claude/main +yes '
exec squadrn account add work
stdout 'new account claude/work'
stdout '^✓ created ~.\.claude-work \(private\)$'
stdout '^✓ settings from claude/main \+ standard profile$'
exists home/.claude-work/settings.json
exists home/.claude-work/.squadrn-managed.json

# The guard judges the PowerShell tool.
stdin ps-force.json
exec squadrn hook guard-git
stdout '"permissionDecision":"deny"'
stdin ps-iex.json
exec squadrn hook guard-git
stdout '"permissionDecision":"ask"'

# Worktrees run through claude --worktree; grid explains that it needs tmux.
exec git init -q repo
cd repo
exec squadrn wt feat-a
stdout 'args=--worktree feat-a$'
! exec squadrn grid ls
stderr 'not available on Windows'
cd $WORK

# Install: command names are copies listed in commands.json; hooks start squadrn.exe directly
# (exec form) and block the tool call when it cannot start.
release rel
exec squadrn self-install rel --alias sx
exists home/.local/bin/srn.exe
exists home/.local/bin/sx.exe
exists home/.local/share/squadrn/commands.json
grep '"onFailure": "block"' home/.local/share/squadrn/plugin/hooks/hooks.json
! grep 'cmd.exe' home/.local/share/squadrn/plugin/hooks/hooks.json
exists home/.local/share/squadrn/completion.ps1
exec squadrn config set aliases ''
! exists home/.local/bin/sx.exe
exec squadrn self-uninstall --yes
! exists home/.local/bin/srn.exe

# cmd.exe would misread a data dir with % ^ & or !.
env XDG_DATA_HOME=$WORK${/}R&D
exitcode 2 squadrn self-install rel
! exec squadrn self-install rel
stderr 'which cmd.exe would misread'

-- empty --
-- ps-force.json --
{"cwd":".","tool_name":"PowerShell","tool_input":{"command":"& git push -f origin x"}}
-- ps-iex.json --
{"cwd":".","tool_name":"PowerShell","tool_input":{"command":"iex 'git push'"}}
-- home/.claude-personal/.squadrn-account --
