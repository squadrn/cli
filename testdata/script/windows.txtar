[!windows] skip 'Windows behaviour; the other scripts cover macOS and Linux'

# Sessions run claude.exe as a child: main without CLAUDE_CONFIG_DIR, other accounts with it.
mkdir home/.claude-personal
exec sprawl -- hi
stdout '^cfg=<unset> args=hi$'
exec sprawl personal -- hi
stdout '^cfg=.*home.\.claude-personal args=hi$'

# Accounts.
cp empty home/.claude/.loggedin
exec sprawl account ls
stdout '^claude/main +yes '
exec sprawl account add work
stdout '^account claude/work'
exists home/.claude-work

# The guard judges the PowerShell tool.
stdin ps-force.json
exec sprawl hook guard-git
stdout '"permissionDecision":"deny"'
stdin ps-iex.json
exec sprawl hook guard-git
stdout '"permissionDecision":"ask"'

# Worktrees run through claude --worktree; grid explains that it needs tmux.
exec git init -q repo
cd repo
exec sprawl wt feat-a
stdout 'args=--worktree feat-a$'
! exec sprawl grid ls
stderr 'not available on Windows'
cd $WORK

# Install: command names are copies listed in commands.json; hooks run through cmd.exe.
release rel
exec sprawl self-install rel --alias sx
exists home/.local/bin/sprawl.exe
exists home/.local/bin/sx.exe
exists home/.local/share/sprawl/commands.json
grep 'cmd.exe' home/.local/share/sprawl/plugin/hooks/hooks.json
exists home/.local/share/sprawl/completion.ps1
exec sprawl config set aliases ''
! exists home/.local/bin/sx.exe
exec sprawl self-uninstall --yes
! exists home/.local/bin/sprawl.exe

# cmd.exe would misread a data dir with % ^ & or !.
env XDG_DATA_HOME=$WORK${/}R&D
exitcode 2 sprawl self-install rel
! exec sprawl self-install rel
stderr 'which cmd.exe would misread'

-- empty --
-- ps-force.json --
{"cwd":".","tool_name":"PowerShell","tool_input":{"command":"& git push -f origin x"}}
-- ps-iex.json --
{"cwd":".","tool_name":"PowerShell","tool_input":{"command":"iex 'git push'"}}
